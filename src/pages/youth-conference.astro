---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';

const highlights = [
  {
    title: 'Powerful Worship Nights',
    desc: 'Two evenings of Spirit-filled worship that left hundreds in tears, revival, and radical encounters with God.',
    color: 'from-navy',
  },
  {
    title: 'Anointed Speakers',
    desc: 'Five guest speakers from across the Caribbean brought bold, transformative messages on identity, purpose, and Kingdom living.',
    color: 'from-gold',
  },
  {
    title: 'Youth Breakout Sessions',
    desc: 'Interactive workshops covering faith and mental health, relationships, career, and living as a Christian in the digital age.',
    color: 'from-coral',
  },
  {
    title: 'Altar Calls & Salvations',
    desc: 'Over 40 young people gave their lives to Christ during the conference altars — the greatest miracle of every gathering.',
    color: 'from-navy',
  },
  {
    title: 'Regional Delegates',
    desc: 'Delegates attended from Jamaica, Trinidad, Barbados, and the UK — a true Caribbean convergence of the next generation.',
    color: 'from-gold',
  },
  {
    title: 'Creative Expressions',
    desc: 'Dance, spoken word, drama, and visual art — the conference celebrated faith expressed through every creative medium.',
    color: 'from-coral',
  },
];

const galleryItems = [
  { label: 'Opening Night Worship', hue: '220', sat: '45%', light: '22%' },
  { label: 'Main Session — Day 1', hue: '35', sat: '50%', light: '40%' },
  { label: 'Youth Breakouts', hue: '18', sat: '55%', light: '38%' },
  { label: 'Prayer & Intercession', hue: '225', sat: '42%', light: '18%' },
  { label: 'Worship Team', hue: '220', sat: '50%', light: '28%' },
  { label: 'Altar Service', hue: '30', sat: '48%', light: '35%' },
  { label: 'Closing Night', hue: '220', sat: '44%', light: '20%' },
  { label: 'Delegate Fellowship', hue: '22', sat: '52%', light: '42%' },
  { label: 'Creative Arts Night', hue: '15', sat: '60%', light: '36%' },
];
---

<Layout
  title="Youth Conference 2023"
  description="Relive the Jesus House Jamaica Youth Conference 2023 — a powerful gathering of Caribbean youth for worship, ministry, and encounter with God. Register interest for next year."
>
  <Nav heroDark={true} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-particles" aria-hidden="true">
      {Array.from({length: 12}).map((_, i) => (
        <div class="particle" style={`left: ${(i * 8) + 4}%; animation-delay: ${i * 0.3}s; animation-duration: ${3 + (i % 4) * 0.5}s`} aria-hidden="true"></div>
      ))}
    </div>
    <div class="container hero-inner">
      <div class="hero-badge" aria-label="Youth Event">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        Youth Conference 2023
      </div>
      <h1 class="hero-title">
        Set Apart.<br/>
        <em>On Fire.</em>
      </h1>
      <p class="hero-sub">
        Three days. One generation. An encounter with God that changed everything.
        Jesus House Jamaica Youth Conference 2023 — Recap & Gallery.
      </p>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-num">3</span>
          <span class="stat-label">Days</span>
        </div>
        <div class="hero-stat">
          <span class="stat-num">5</span>
          <span class="stat-label">Speakers</span>
        </div>
        <div class="hero-stat">
          <span class="stat-num">40+</span>
          <span class="stat-label">Salvations</span>
        </div>
        <div class="hero-stat">
          <span class="stat-num">4</span>
          <span class="stat-label">Islands</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About the Conference -->
  <section class="about-section">
    <div class="container about-grid">
      <div class="about-text">
        <span class="section-label">The Conference</span>
        <h2 class="about-heading">A Gathering for the Next Generation</h2>
        <p>
          The Jesus House Jamaica Youth Conference has been one of the flagship events on the
          Caribbean RCCG calendar for over a decade. In 2023, the conference theme — <strong>"Set Apart"</strong> —
          called young believers to a radical consecration: to present themselves as living sacrifices,
          holy and acceptable to God (Romans 12:1).
        </p>
        <p>
          The three-day gathering drew young people from across Jamaica and the wider Caribbean
          for an immersive experience of worship, teaching, prayer, and community. For many delegates,
          it was a defining moment — the conference where they said yes to God's call on their lives.
        </p>
        <div class="about-theme">
          <div class="theme-badge">
            <span class="theme-label">2023 Theme</span>
            <span class="theme-title">"Set Apart"</span>
            <span class="theme-ref">Romans 12:1</span>
          </div>
        </div>
      </div>
      <div class="about-details">
        <div class="detail-card">
          <div class="detail-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <p class="detail-label">Dates</p>
            <p class="detail-value">October 20–22, 2023</p>
          </div>
        </div>
        <div class="detail-card">
          <div class="detail-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="detail-label">Venue</p>
            <a href="https://maps.google.com/?q=3+McGregor+Square,+corner+of+Beechwood+Avenue,+off+Halfway+Tree,+Kingston+5,+Jamaica" target="_blank" rel="noopener noreferrer" class="detail-value">Jesus House Jamaica, 3 McGregor Square, Kingston 5</a>
          </div>
        </div>
        <div class="detail-card">
          <div class="detail-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <p class="detail-label">Attendees</p>
            <p class="detail-value">250+ delegates from 4 Caribbean islands</p>
          </div>
        </div>
        <div class="detail-card">
          <div class="detail-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <p class="detail-label">Age Range</p>
            <p class="detail-value">Teenagers and young adults (14–35)</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="highlights-section">
    <div class="container">
      <div class="highlights-header">
        <span class="section-label">2023 Highlights</span>
        <h2 class="highlights-heading">What God Did</h2>
      </div>

      <div class="highlights-grid">
        {highlights.map((item) => (
          <div class="highlight-card">
            <div class={`highlight-accent highlight-accent--${item.color}`} aria-hidden="true"></div>
            <h3 class="highlight-title">{item.title}</h3>
            <p class="highlight-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="gallery-section">
    <div class="container">
      <div class="gallery-header">
        <span class="section-label">Photo Gallery</span>
        <h2 class="gallery-heading">Conference Moments</h2>
        <p class="gallery-sub">A glimpse into the three extraordinary days of the 2023 Youth Conference.</p>
      </div>

      <div class="gallery-grid">
        {galleryItems.map((item, idx) => (
          <div
            class={`gallery-item${idx === 0 || idx === 4 ? ' gallery-item--wide' : ''}`}
            style={`background: linear-gradient(135deg, hsl(${item.hue}, ${item.sat}, ${item.light}) 0%, hsl(${item.hue}, ${item.sat}, calc(${item.light} - 8%)) 100%)`}
            aria-label={item.label}
            role="img"
          >
            <span class="gallery-label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Next Conference Interest Form -->
  <section class="register-section">
    <div class="container register-inner">
      <div class="register-text">
        <span class="section-label">Coming Soon</span>
        <h2 class="register-heading">Youth Conference 2024</h2>
        <p class="register-sub">
          Be the first to know when dates and details for the next Youth Conference are announced.
          Register your interest below and we'll keep you updated.
        </p>
        <div class="register-info">
          <div class="reg-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Dates to be announced
          </div>
          <div class="reg-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Jesus House Jamaica, Kingston
          </div>
          <div class="reg-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            For ages 14–35
          </div>
        </div>
      </div>

      <form class="register-form" action="#" method="POST" novalidate>
        <h3 class="form-heading">Register Your Interest</h3>

        <div class="form-group">
          <label for="conf-name" class="form-label">Full Name</label>
          <input type="text" id="conf-name" name="name" class="form-input" placeholder="Your full name" required />
        </div>

        <div class="form-group">
          <label for="conf-email" class="form-label">Email Address</label>
          <input type="email" id="conf-email" name="email" class="form-input" placeholder="your@email.com" required />
        </div>

        <div class="form-group">
          <label for="conf-phone" class="form-label">Phone Number</label>
          <input type="tel" id="conf-phone" name="phone" class="form-input" placeholder="+1 876 000 0000" />
        </div>

        <div class="form-group">
          <label for="conf-island" class="form-label">Island / Country</label>
          <select id="conf-island" name="island" class="form-input">
            <option value="">Select your island/country</option>
            <option value="jamaica">Jamaica</option>
            <option value="trinidad">Trinidad & Tobago</option>
            <option value="barbados">Barbados</option>
            <option value="bahamas">Bahamas</option>
            <option value="uk">United Kingdom</option>
            <option value="usa">United States</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-group">
          <label for="conf-message" class="form-label">Message (optional)</label>
          <textarea id="conf-message" name="message" class="form-input form-textarea" placeholder="Any questions or comments?"></textarea>
        </div>

        <button type="submit" class="btn btn-gold form-submit">
          Register Interest
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </form>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    background-color: var(--color-navy);
    position: relative;
    overflow: hidden;
    padding: 9rem 0 6rem;
    min-height: 540px;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 80% 20%, rgba(212, 168, 67, 0.2) 0%, transparent 50%),
      radial-gradient(ellipse at 10% 80%, rgba(224, 90, 43, 0.15) 0%, transparent 50%);
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    bottom: -10px;
    width: 4px;
    height: 4px;
    background-color: var(--color-gold);
    border-radius: 50%;
    opacity: 0.5;
    animation: float-up linear infinite;
  }

  @keyframes float-up {
    0% { transform: translateY(0) scale(1); opacity: 0.5; }
    100% { transform: translateY(-600px) scale(0); opacity: 0; }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 700px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-gold);
    color: var(--color-navy);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
    line-height: 1.05;
  }

  .hero-title em {
    font-style: italic;
    color: var(--color-gold);
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.75;
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 900;
    color: var(--color-gold);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  /* About */
  .about-section {
    background-color: var(--color-cream);
    padding: var(--section-padding) 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .about-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-navy);
    margin-bottom: 1.25rem;
  }

  .about-text p {
    font-size: 0.975rem;
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .about-theme {
    margin-top: 2rem;
  }

  .theme-badge {
    display: inline-flex;
    flex-direction: column;
    background-color: var(--color-navy);
    border-radius: var(--radius-card);
    padding: 1.5rem 2rem;
    gap: 0.25rem;
  }

  .theme-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .theme-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    font-style: italic;
    color: var(--color-gold);
    line-height: 1.1;
  }

  .theme-ref {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
  }

  .about-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .detail-card {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    border: 1px solid rgba(13, 27, 62, 0.07);
  }

  .detail-icon {
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .detail-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.2rem;
  }

  .detail-value {
    font-size: 0.9rem;
    color: var(--color-navy);
    font-weight: 500;
    line-height: 1.4;
  }

  /* Highlights */
  .highlights-section {
    background-color: var(--color-white);
    padding: var(--section-padding) 0;
  }

  .highlights-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .highlights-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-navy);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .highlights-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .highlights-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .highlight-card {
    background-color: var(--color-cream);
    border-radius: var(--radius-card);
    padding: 2rem 1.75rem;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(13, 27, 62, 0.06);
  }

  .highlight-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
  }

  .highlight-accent--from-navy { background: linear-gradient(90deg, var(--color-navy), #2a3f6e); }
  .highlight-accent--from-gold { background: linear-gradient(90deg, var(--color-gold), #c4952e); }
  .highlight-accent--from-coral { background: linear-gradient(90deg, var(--color-coral), #b8401c); }

  .highlight-title {
    font-size: 1.1rem;
    color: var(--color-navy);
    margin-bottom: 0.625rem;
  }

  .highlight-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* Gallery */
  .gallery-section {
    background-color: var(--color-navy);
    padding: var(--section-padding) 0;
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .gallery-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .gallery-sub {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    border-radius: 0.5rem;
    min-height: 160px;
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.25s ease;
  }

  .gallery-item--wide {
    grid-column: span 2;
    min-height: 200px;
  }

  .gallery-item:hover {
    transform: scale(0.98);
  }

  .gallery-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    padding: 0.5rem 0.75rem;
    background: linear-gradient(transparent, rgba(0,0,0,0.5));
    width: 100%;
    letter-spacing: 0.06em;
  }

  /* Register */
  .register-section {
    background-color: var(--color-cream);
    padding: var(--section-padding) 0;
  }

  .register-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .register-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .register-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-navy);
    margin-bottom: 0.875rem;
  }

  .register-sub {
    font-size: 0.975rem;
    color: var(--color-muted);
    line-height: 1.75;
    margin-bottom: 1.75rem;
  }

  .register-info {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .reg-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    color: var(--color-navy);
    font-weight: 500;
  }

  .reg-item svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .register-form {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    border: 1px solid rgba(13, 27, 62, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-heading {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-navy);
    letter-spacing: 0.06em;
  }

  .form-input {
    padding: 0.75rem 1rem;
    border: 1.5px solid rgba(13, 27, 62, 0.15);
    border-radius: 0.375rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text);
    background-color: var(--color-white);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    width: 100%;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.15);
  }

  .form-input::placeholder {
    color: rgba(107, 114, 128, 0.6);
  }

  .form-textarea {
    min-height: 100px;
    resize: vertical;
  }

