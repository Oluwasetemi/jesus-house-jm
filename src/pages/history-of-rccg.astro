---
import Footer from '../components/footer.astro'
import Nav from '../components/nav.astro'
import Layout from '../layouts/Layout.astro'

const rccgTimeline = [
  {
    year: '1952',
    title: 'The Founding Vision',
    text: 'The Redeemed Christian Church of God was founded in Lagos, Nigeria by the Reverend Josiah Olufemi Akindayomi. Illiterate but Spirit-filled, this humble servant of God received a divine mandate to plant a church that would reach the nations. He named it "Egbe Ijo Eda Mimo Ti A Ra Pada" — the Redeemed Christian Church of God.',
    highlight: true,
  },
  {
    year: '1973',
    title: 'The Founding Pastor\'s Passing',
    text: 'Rev. Josiah Akindayomi passed away, but not before recording his succession instructions on tape — instructions that would confirm Pastor Enoch Adejare Adeboye as his successor, in fulfilment of a divine prophecy.',
  },
  {
    year: '1981',
    title: 'Pastor Adeboye Takes the Helm',
    text: 'Pastor Enoch A. Adeboye, then a Mathematics lecturer at the University of Lagos, became the General Overseer of RCCG. Under his visionary leadership, the church would embark on an extraordinary era of global expansion.',
  },
  {
    year: '1986',
    title: 'Holy Ghost Night Begins',
    text: 'The first Holy Ghost Night prayer meeting was held — a monthly all-night gathering that would grow to become one of the largest single religious gatherings on earth, drawing millions to the RCCG Redemption Camp outside Lagos.',
    highlight: true,
  },
  {
    year: '1992',
    title: 'RCCG Reaches North America',
    text: 'RCCG established its first parishes in North America, laying the groundwork for what would become a massive Diaspora church movement reaching every English-speaking nation on earth.',
  },
  {
    year: '1998',
    title: 'RCCG Arrives in Jamaica',
    text: 'The Redeemed Christian Church of God planted its first parish in Jamaica, marking the beginning of the RCCG\'s Caribbean expansion. Jesus House Jamaica emerged from these early pioneering efforts.',
  },
  {
    year: '2000s',
    title: 'Caribbean Network Expands',
    text: 'RCCG parishes multiplied across the Caribbean — in Jamaica, Trinidad, Barbados, the Bahamas, and beyond. A regional oversight structure was established to support and unify these growing congregations.',
  },
  {
    year: '2012',
    title: 'RCCG in 198+ Nations',
    text: 'RCCG officially confirmed its presence in 198 nations, fulfilling a key dimension of its vision to "make heaven and take as many people as possible with us." The church is now one of the fastest-growing denominations in the world.',
    highlight: true,
  },
]

const jhTimeline = [
  {
    year: 'Early 2000s',
    title: 'Jesus House Jamaica Established',
    text: 'Pastors George and Deborah Kamalu, under the authority and oversight of RCCG Caribbean, planted Jesus House Jamaica in Kingston — beginning with a small gathering of Spirit-filled believers hungry for authentic encounter with God.',
  },
  {
    year: '2005',
    title: 'Growth & First Building',
    text: 'The congregation grew rapidly and moved into its first dedicated church facility. The church began to establish its core ministries and attract families and young people from across the Kingston metropolitan area.',
  },
  {
    year: '2009',
    title: 'Youth Ministry Launched',
    text: 'The Jesus House Jamaica Youth Ministry was formally launched, establishing programmes that would nurture hundreds of young people in faith, character, and purpose — culminating in the annual Youth Conference.',
  },
  {
    year: '2015',
    title: 'Women\'s Fellowship Established',
    text: 'Pastor Deborah Kamalu founded the Jesus House Women\'s Fellowship, creating a transformative space for women to grow spiritually, find healing, and discover their God-given callings.',
  },
  {
    year: '2020',
    title: 'Going Online',
    text: 'In response to the COVID-19 pandemic, Jesus House Jamaica launched online worship, Zoom Bible Studies, and digital outreach — extending its reach to hundreds of viewers across Jamaica and the global Diaspora.',
  },
  {
    year: 'Present',
    title: 'Continuing the Mission',
    text: 'Today, Jesus House Jamaica stands as a thriving, Spirit-filled community at 3 McGregor Square, Halfway Tree, Kingston — worshipping every Sunday at 9:00 AM, empowering men and women for godly living, and pressing forward into its God-given destiny.',
  },
];
---

<Layout
  title="History of RCCG"
  description="Discover the history of the Redeemed Christian Church of God — from its founding in Nigeria in 1952 to its global presence, and the story of Jesus House Jamaica."
>
  <Nav heroDark={true} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="section-label">Heritage & Legacy</span>
      <h1 class="hero-title">History of RCCG</h1>
      <p class="hero-sub">
        From a humble prayer meeting in Lagos in 1952 to a movement spanning 198 nations —
        this is the story of the Redeemed Christian Church of God.
      </p>
    </div>
  </section>

  <!-- RCCG Intro -->
  <section class="intro-section">
    <div class="container intro-grid">
      <div class="intro-text">
        <span class="section-label">The RCCG Story</span>
        <h2 class="intro-heading">Founded in Faith, Built for the Nations</h2>
        <p>
          The Redeemed Christian Church of God began not in a cathedral, but in a modest room
          in Lagos, Nigeria — the fruit of one man's encounter with the living God. Rev. Josiah
          Akindayomi, an unlettered but Spirit-baptised pastor, received a mandate that seemed
          impossible by human standards: to plant a church that would reach every nation on earth.
        </p>
        <p>
          Seventy years later, that mandate has been fulfilled beyond anything the founder could
          have imagined. With parishes in 198+ nations, millions of members worldwide, and one of
          the largest single religious gatherings on earth — the RCCG stands as a testament to
          what God can do through yielded vessels.
        </p>
      </div>
      <div class="intro-stats">
        <div class="stat-item">
          <span class="stat-num">1952</span>
          <span class="stat-label">Year of Founding</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">198+</span>
          <span class="stat-label">Nations Reached</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">50,000+</span>
          <span class="stat-label">Parishes Worldwide</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">Jamaica</span>
          <span class="stat-label">Caribbean Hub</span>
        </div>
      </div>
    </div>
  </section>

  <!-- RCCG Timeline -->
  <section class="timeline-section">
    <div class="container">
      <div class="timeline-header">
        <span class="section-label">Global Timeline</span>
        <h2 class="timeline-heading">Key Milestones of RCCG</h2>
      </div>

      <div class="timeline">
        {rccgTimeline.map(item => (
          <div class={`timeline-item${item.highlight ? ' timeline-item--highlight' : ''}`}>
            <div class="timeline-dot" aria-hidden="true">
              {item.highlight && (
                <div class="timeline-dot-ring" aria-hidden="true"></div>
              )}
            </div>
            <div class="timeline-line-segment" aria-hidden="true"></div>
            <div class="timeline-content">
              <span class="timeline-year">{item.year}</span>
              <h3 class="timeline-title">{item.title}</h3>
              <p class="timeline-text">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Jesus House Jamaica Timeline -->
  <section class="jh-section">
    <div class="container">
      <div class="jh-header">
        <span class="section-label">Our Local Story</span>
        <h2 class="jh-heading">Jesus House Jamaica</h2>
        <p class="jh-sub">
          How the RCCG story came alive on Jamaican soil — through faith, prayer, and the call of God.
        </p>
      </div>

      <div class="jh-timeline">
        {jhTimeline.map((item, idx) => (
          <div class="jh-item">
            <div class="jh-year-col">
              <div class="jh-year-badge">{item.year}</div>
              {idx < jhTimeline.length - 1 && <div class="jh-connector" aria-hidden="true"></div>}
            </div>
            <div class="jh-content">
              <h3 class="jh-title">{item.title}</h3>
              <p class="jh-text">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="history-cta">
    <div class="container history-cta-inner">
      <h2 class="cta-heading">We Are Part of This Story</h2>
      <p class="cta-sub">
        Every Sunday at Jesus House Jamaica, we add another chapter to this great story of faith.
        Come join us — there is room for you in this ongoing move of God.
      </p>
      <div class="cta-btns">
        <a href="/general-overseers" class="btn btn-gold">Meet Our General Overseer</a>
        <a href="/our-pastors" class="btn btn-outline-white">Our Local Pastors</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    background-color: var(--color-navy);
    position: relative;
    overflow: hidden;
    padding: 9rem 0 6rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 60%, rgba(212, 168, 67, 0.12) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 15%, rgba(224, 90, 43, 0.07) 0%, transparent 50%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.75;
    max-width: 54ch;
  }

  /* Intro */
  .intro-section {
    background-color: var(--color-cream);
    padding: var(--section-padding) 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .intro-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .intro-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-navy);
    margin-bottom: 1.25rem;
  }

  .intro-text p {
    font-size: 0.975rem;
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .intro-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .stat-item {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 1.75rem 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid rgba(13, 27, 62, 0.07);
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-gold);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
    line-height: 1.4;
  }

  /* RCCG Timeline */
  .timeline-section {
    background-color: var(--color-white);
    padding: var(--section-padding) 0;
  }

  .timeline-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .timeline-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-navy);
  }

  .timeline {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    padding-left: 2.5rem;
  }

  @media (min-width: 640px) {
    .timeline {
      padding-left: 3.5rem;
    }
  }

  /* Vertical line */
  .timeline::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-gold), rgba(212, 168, 67, 0.1));
  }

  @media (min-width: 640px) {
    .timeline::before {
      left: 16px;
    }
  }

  .timeline-item {
    position: relative;
    padding-bottom: 3rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -2.5rem;
    top: 0.25rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--color-gold);
    border: 3px solid var(--color-white);
    box-shadow: 0 0 0 2px var(--color-gold);
  }

  @media (min-width: 640px) {
    .timeline-dot {
      left: -3.5rem;
    }
  }

  .timeline-item--highlight .timeline-dot {
    background-color: var(--color-coral);
    box-shadow: 0 0 0 2px var(--color-coral);
    width: 24px;
    height: 24px;
    top: 0.15rem;
    left: calc(-3.5rem + 2px);
  }

  @media (max-width: 639px) {
    .timeline-item--highlight .timeline-dot {
      left: calc(-2.5rem + 2px);
    }
  }

  .timeline-dot-ring {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid rgba(224, 90, 43, 0.3);
    animation: ping-ring 2s ease-in-out infinite;
  }

  @keyframes ping-ring {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0; transform: scale(1.5); }
  }

  .timeline-year {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-gold);
    margin-bottom: 0.25rem;
    line-height: 1;
  }

  .timeline-item--highlight .timeline-year {
    color: var(--color-coral);
  }

  .timeline-title {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.625rem;
  }

  .timeline-text {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 62ch;
  }

  /* JH Section */
  .jh-section {
    background-color: var(--color-navy);
    padding: var(--section-padding) 0;
  }

  .jh-header {
    text-align: center;
    margin-bottom: 3.5rem;
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: 3.5rem;
  }

  .jh-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-white);
    margin-bottom: 0.875rem;
  }

  .jh-sub {
    font-size: 0.975rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
  }

  .jh-timeline {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .jh-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0 2rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .jh-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .jh-year-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .jh-year-col {
      align-items: flex-start;
    }
  }

  .jh-year-badge {
    background-color: rgba(212, 168, 67, 0.12);
    border: 1px solid rgba(212, 168, 67, 0.2);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    white-space: nowrap;
  }

  .jh-connector {
    width: 1px;
    flex: 1;
    min-height: 40px;
    background: rgba(212, 168, 67, 0.15);
    margin: 0.5rem auto;
  }

  @media (max-width: 640px) {
    .jh-connector {
      display: none;
    }
  }

  .jh-content {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 0.25rem;
  }

  .jh-item:last-child .jh-content {
    border-bottom: none;
    padding-bottom: 0;
  }

  .jh-title {
    font-size: 1.1rem;
    color: var(--color-white);
    margin-bottom: 0.625rem;
  }

  .jh-text {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.75;
  }

  /* CTA */
  .history-cta {
    background: linear-gradient(135deg, #0a1630 0%, var(--color-navy) 100%);
    padding: 5rem 0;
  }

  .history-cta-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .cta-sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  /* ── Mobile overrides ─────────────────────────────── */
  @media (max-width: 640px) {
    [class$="-hero"] { padding-top: 5.5rem; padding-bottom: 3.5rem; }
    [class*="-card"] { padding: 1.5rem 1.25rem; }
  }
</style>
