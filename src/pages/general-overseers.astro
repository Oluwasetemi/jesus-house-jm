---
import Layout from '../layouts/Layout.astro'

const vision = [
  {
    title: 'Make Heaven',
    desc: 'Pastor Adeboye has consistently championed the RCCG\'s primary mission: to make heaven. Everything else — the church growth, the programmes, the global reach — is in service of this eternal goal.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12l2.5 2.5L16 9"/></svg>`,
  },
  {
    title: 'Global Evangelism',
    desc: 'Under his leadership, RCCG has planted churches in 198+ nations — fulfilling the Great Commission in ways that few Christian movements in history have achieved.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  },
  {
    title: 'A Church in Every Street',
    desc: 'One of the most daring visions in modern church history — Pastor Adeboye declared RCCG\'s intention to plant a church within five minutes\' walk of every person in every city, town, and village on earth.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    title: 'Raising Leaders',
    desc: 'Pastor Adeboye\'s ministry of pastoral development has raised thousands of pastors and church planters who serve across every continent, carrying the RCCG\'s apostolic mandate forward.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];
---

<Layout heroDark={true}
  title="General Overseers"
  description="Learn about Pastor Enoch Adeboye, the General Overseer of the Redeemed Christian Church of God (RCCG) — the spiritual leader of the global RCCG family, including Jesus House Jamaica."
>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="section-label">RCCG Leadership</span>
      <h1 class="hero-title">General Overseer</h1>
      <p class="hero-sub">
        Spiritual father, apostolic leader, and servant of God — the shepherd whose vision
        guides the global RCCG family, including Jesus House Jamaica.
      </p>
    </div>
  </section>

  <!-- Featured: Pastor Adeboye -->
  <section class="go-section">
    <div class="container go-grid">

      <!-- Photo Placeholder -->
      <div class="go-portrait" aria-label="Portrait of Pastor Enoch Adeboye">
        <div class="go-avatar">
          <span class="go-initials">E.A.</span>
          <div class="go-avatar-ring" aria-hidden="true"></div>
          <div class="go-avatar-ring go-avatar-ring--outer" aria-hidden="true"></div>
        </div>
        <div class="go-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
          General Overseer, RCCG
        </div>
      </div>

      <!-- Bio -->
      <div class="go-bio">
        <span class="section-label">Apostolic Leader</span>
        <h2 class="go-name">Pastor Enoch Adejare Adeboye</h2>
        <p class="go-title-line">General Overseer, Redeemed Christian Church of God</p>

        <div class="go-bio-text">
          <p>
            Pastor Enoch Adejare Adeboye is the General Overseer of the Redeemed Christian Church of God
            (RCCG) — one of the fastest-growing and most widespread Christian denominations in the world.
            Born in 1942 in Ifewara, Osun State, Nigeria, Pastor Adeboye was raised in abject poverty
            but possessed an exceptional intellect, earning a PhD in Applied Mathematics from the
            University of Lagos where he later served as a lecturer.
          </p>
          <p>
            In 1973, at the age of 39, Pastor Adeboye gave his life to Christ. His encounter with
            God was radical and transformative. By 1981, at the prompting of the Holy Spirit and in
            fulfilment of the late Rev. Josiah Akindayomi's recorded testament, he assumed leadership
            of the RCCG — a congregation of just 40 members meeting in Lagos.
          </p>
          <p>
            Under his leadership, RCCG has grown to encompass over 50,000 parishes in 198+ nations,
            with tens of millions of members worldwide. The annual Holy Ghost Night he instituted
            draws millions to the RCCG's Redemption Camp — one of the largest single gatherings of
            Christians anywhere on earth. Time Magazine recognised Pastor Adeboye as one of the
            50 most influential people in the world.
          </p>
          <p>
            For Jesus House Jamaica, Pastor Adeboye is our spiritual grandfather in the faith —
            the apostolic leader whose vision, prayers, and anointing flow down through the RCCG
            network into our congregation and ministry in Kingston.
          </p>
        </div>

        <div class="go-quote">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
          </svg>
          <div>
            <p class="quote-text">
              "The most important thing in life is not success — it is making it to heaven and
              taking as many people as possible with you."
            </p>
            <span class="quote-attr">— Pastor E.A. Adeboye</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision Pillars -->
  <section class="vision-section">
    <div class="container">
      <div class="vision-header">
        <span class="section-label">His Vision</span>
        <h2 class="vision-heading">A Vision for the Nations</h2>
        <p class="vision-sub">
          The four cornerstones of Pastor Adeboye's apostolic vision that have shaped the
          global RCCG movement — and continue to inspire Jesus House Jamaica.
        </p>
      </div>

      <div class="vision-grid">
        {vision.map(item => (
          <div class="vision-card">
            <div class="vision-icon" aria-hidden="true" set:html={item.icon} />
            <h3 class="vision-title">{item.title}</h3>
            <p class="vision-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Regional Oversight -->
  <section class="regional-section">
    <div class="container regional-inner">
      <div class="regional-text">
        <span class="section-label">Caribbean Oversight</span>
        <h2 class="regional-heading">Our Regional Leadership</h2>
        <p>
          Jesus House Jamaica operates within the RCCG Caribbean Regional structure. Our regional
          overseers provide apostolic covering, pastoral support, and strategic guidance to all RCCG
          parishes across the Caribbean islands — connecting us to the global RCCG family and
          holding us accountable to the movement's mission and values.
        </p>
        <p>
          Through the regional network, Jesus House Jamaica benefits from RCCG's global resources,
          training programmes, annual conventions, and the spiritual authority that flows from
          Pastor Adeboye's apostolic leadership.
        </p>
      </div>
      <div class="regional-card">
        <div class="regional-card-header">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="2" y1="12" x2="22" y2="12" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span>RCCG Caribbean Region</span>
        </div>
        <ul class="regional-list">
          <li>Regional pastoral support & oversight</li>
          <li>Annual Caribbean conventions</li>
          <li>Minister training & development</li>
          <li>Parish planting support</li>
          <li>Cross-island mission partnerships</li>
          <li>Connection to global RCCG network</li>
        </ul>
        <a href="/history-of-rccg" class="btn btn-outline-white" style="margin-top:1.5rem; display:inline-flex;">
          RCCG History
        </a>
      </div>
    </div>
  </section>

  <!-- Scripture -->
  <section class="scripture-section">
    <div class="container scripture-inner">
      <blockquote class="scripture-quote">
        "And I will give you shepherds after my own heart, who will feed you with knowledge and understanding."
      </blockquote>
      <cite class="scripture-ref">— Jeremiah 3:15 (ESV)</cite>
      <p class="scripture-note">
        We thank God for faithful shepherds — from Pastor Adeboye at the global level to
        Pastors George and Deborah Kamalu here in Kingston.
      </p>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero {
    background-color: var(--color-navy);
    position: relative;
    overflow: hidden;
    padding: 9rem 0 6rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 65% 30%, rgba(212, 168, 67, 0.12) 0%, transparent 55%),
      radial-gradient(ellipse at 15% 80%, rgba(224, 90, 43, 0.07) 0%, transparent 50%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.75;
    max-width: 52ch;
  }

  /* GO Section */
  .go-section {
    background-color: var(--color-cream);
    padding: var(--section-padding) 0;
  }

  .go-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .go-grid {
      grid-template-columns: 280px 1fr;
    }
  }

  .go-portrait {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .go-avatar {
    position: relative;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-gold) 0%, #c4952e 60%, var(--color-coral) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .go-initials {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 900;
    color: var(--color-navy);
  }

  .go-avatar-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(212, 168, 67, 0.25);
  }

  .go-avatar-ring--outer {
    inset: -16px;
    border-color: rgba(212, 168, 67, 0.1);
  }

  .go-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-navy);
    color: var(--color-gold);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
  }

  .go-name {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    color: var(--color-navy);
    margin-bottom: 0.25rem;
  }

  .go-title-line {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-coral);
    margin-bottom: 1.75rem;
  }

  .go-bio-text p {
    font-size: 0.975rem;
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .go-quote {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background-color: var(--color-navy);
    border-radius: var(--radius-card);
    padding: 1.75rem 2rem;
    margin-top: 1.75rem;
  }

  .go-quote svg {
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .quote-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-white);
    line-height: 1.6;
    margin-bottom: 0.625rem;
  }

  .quote-attr {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  /* Vision */
  .vision-section {
    background-color: var(--color-white);
    padding: var(--section-padding) 0;
  }

  .vision-header {
    text-align: center;
    margin-bottom: 3.5rem;
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: 3.5rem;
  }

  .vision-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-navy);
    margin-bottom: 0.875rem;
  }

  .vision-sub {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .vision-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .vision-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .vision-card {
    background-color: var(--color-cream);
    border-radius: var(--radius-card);
    padding: 2.25rem 2rem;
    border-left: 4px solid var(--color-gold);
    transition: transform 0.25s ease;
  }

  .vision-card:hover {
    transform: translateX(4px);
  }

  .vision-icon {
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .vision-title {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.625rem;
  }

  .vision-desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.75;
  }

  /* Regional */
  .regional-section {
    background-color: var(--color-navy);
    padding: var(--section-padding) 0;
  }

  .regional-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .regional-inner {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .regional-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .regional-text p {
    font-size: 0.975rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .regional-card {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(212, 168, 67, 0.2);
    border-radius: var(--radius-card);
    padding: 2.25rem 2rem;
  }

  .regional-card-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-gold);
    margin-bottom: 1.5rem;
    font-weight: 700;
  }

  .regional-card-header svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .regional-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .regional-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .regional-list li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-gold);
    flex-shrink: 0;
  }

  /* Scripture */
  .scripture-section {
    background-color: var(--color-cream);
    padding: var(--section-padding) 0;
    text-align: center;
  }

  .scripture-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .scripture-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--color-navy);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .scripture-ref {
    display: block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 2rem;
  }

  .scripture-note {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 52ch;
    margin: 0 auto;
  }
  /* ── Mobile overrides ─────────────────────────────── */
  @media (max-width: 640px) {
    [class$="-hero"] { padding-top: 5.5rem; padding-bottom: 3.5rem; }
    [class*="-card"] { padding: 1.5rem 1.25rem; }
  }
</style>
