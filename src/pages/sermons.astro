---
import { create, insertMultiple } from '@orama/orama'
import { persist } from '@orama/plugin-data-persistence'
import Footer from '../components/footer.astro'
import Nav from '../components/nav.astro'
import rawVideos from '../data/videos.json'
import Layout from '../layouts/Layout.astro'

const YOUTUBE_STREAMS = 'https://www.youtube.com/@jesushousekingston/streams'

// Newest first
const allVideos = [...rawVideos].sort((a, b) => b.date.localeCompare(a.date))

// Featured = most recent Sunday Service
const featuredVideo = allVideos.find(v => v.category === 'Sunday Service') ?? allVideos[0]

// Group by "YYYY-Month"
interface MonthGroup {
  month: string
  monthShort: string
  year: string
  id: string
  videos: typeof allVideos
}
const monthMap = new Map<string, MonthGroup>()
for (const v of allVideos) {
  const key = `${v.year}-${v.month}`
  if (!monthMap.has(key)) {
    monthMap.set(key, { month: v.month, monthShort: v.monthShort, year: v.year, id: key.toLowerCase().replace(/\s+/g, '-'), videos: [] })
  }
  monthMap.get(key)!.videos.push(v)
}

// Show 8 most recent months; rest via YouTube link
const MAX_MONTHS = 8
const monthGroups = [...monthMap.values()].slice(0, MAX_MONTHS)

// Build search index at compile time
const searchDb = await create({
  schema: {
    id: 'string',
    title: 'string',
    description: 'string',
    category: 'enum', // 'enum' enables where: { category: { eq: '...' } } filtering
    date: 'string',
    dateShort: 'string',
    duration: 'string',
    views: 'number',
    url: 'string',
    thumbnail: 'string',
    weekday: 'string',
  } as const,
})

await insertMultiple(searchDb, allVideos.map(v => ({
  id: v.id,
  title: v.title,
  description: (v as any).description ?? '',
  category: v.category,
  date: v.date,
  dateShort: v.dateShort,
  duration: v.duration,
  views: v.views,
  url: v.url,
  thumbnail: v.thumbnail,
  weekday: v.weekday,
})))

const serializedIndex = await persist(searchDb, 'json') as string
---

<Layout
  title="Sermons"
  description="Browse the full sermon archive of Jesus House Jamaica — audio and video messages organized by month, series, and pastor. Faith, renewal, and the Word of God."
>
  <Nav />

  <!-- Hero -->
  <section class="sermons-hero">
    <div class="sermons-hero-bg" aria-hidden="true"></div>
    <div class="container sermons-hero-inner">
      <span class="section-label">The Word</span>
      <h1 class="sermons-hero-title">Sermons & Messages</h1>
      <p class="sermons-hero-sub">
        Every message is an invitation — to know God more deeply, to grow in grace,
        and to be transformed by the living Word.
      </p>
    </div>
  </section>

  <!-- Featured Sermon -->
  <section class="featured-section">
    <div class="container">
      <span class="section-label">Featured Message</span>
      <div class="featured-card">
        <div class="featured-thumb">
          <img
            src={featuredVideo.thumbnail}
            alt={featuredVideo.title}
            loading="lazy"
            width="480"
            height="270"
          />
          <a
            href={featuredVideo.url}
            target="_blank"
            rel="noopener noreferrer"
            class="play-btn"
            aria-label={`Watch ${featuredVideo.title} on YouTube`}
          >
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
          </a>
        </div>
        <div class="featured-info">
          <div class="featured-meta">
            <span class="featured-series">{featuredVideo.category}</span>
            <span class="featured-sep" aria-hidden="true">·</span>
            <span class="featured-date">{featuredVideo.dateNice}</span>
          </div>
          <h2 class="featured-title">{featuredVideo.title}</h2>
          <p class="featured-pastor">Pastor George Kamalu</p>
          <p class="featured-desc">
            {featuredVideo.weekday} service — {featuredVideo.duration} &nbsp;·&nbsp; {featuredVideo.views.toLocaleString()} views
          </p>
          <div class="featured-actions">
            <a
              href={featuredVideo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-gold"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3" />
              </svg>
              Watch on YouTube
            </a>
            <a href="/watch-live" class="btn btn-outline-navy">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><polygon points="10 8 16 12 10 16 10 8" />
              </svg>
              Watch Live
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Month Filter Tabs -->
  <section class="archive-section">
    <div class="container">
      <div class="archive-header">
        <h2 class="archive-title">Sermon Archive</h2>
        <p class="archive-sub">Browse messages by month and series.</p>
      </div>

      <!-- Search bar -->
      <form class="search-form" role="search" aria-label="Search sermons">
        <div class="search-input-wrap">
          <svg
            class="search-icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            id="sermon-search"
            type="search"
            class="search-input"
            placeholder="Search sermons…"
            aria-label="Search sermons by title, topic, or scripture"
            autocomplete="off"
            spellcheck="false"
          />
          <button
            type="button"
            id="search-clear"
            class="search-clear"
            aria-label="Clear search"
            hidden
          >×</button>
        </div>
      </form>

      <!-- Search results panel (hidden until user types) -->
      <div id="search-results-panel" hidden>
        <div class="search-results-header">
          <p id="search-results-count" class="search-results-count" aria-live="polite"></p>
          <div class="search-category-pills" role="group" aria-label="Filter by category">
            <button class="cat-pill cat-pill--active" data-category="">All</button>
            <button class="cat-pill" data-category="Sunday Service">Sunday Service</button>
            <button class="cat-pill" data-category="Wednesday Prayer Meeting">Wednesday Prayer</button>
            <button class="cat-pill" data-category="Good Morning Jesus">Good Morning Jesus</button>
            <button class="cat-pill" data-category="Special Service">Special Service</button>
          </div>
        </div>

        <div id="search-results-list" class="sermon-list search-results-list">
          <!-- populated by client script -->
        </div>

        <p id="search-no-results" class="search-no-results" hidden>
          No sermons found.
          <a
            href="https://www.youtube.com/@jesushousekingston/streams"
            target="_blank"
            rel="noopener noreferrer"
          >Browse all on YouTube ↗</a>
        </p>
      </div>

      <!-- Month navigation tabs -->
      <div class="tabs-container">
        <div class="tabs-scroll" role="tablist" aria-label="Filter sermons by month">
          {monthGroups.map(g => (
            <a href={`#month-${g.id}`} class="tab-btn" role="tab">
              {g.month} {g.year}
            </a>
          ))}
          <a
            href={YOUTUBE_STREAMS}
            target="_blank"
            rel="noopener noreferrer"
            class="tab-btn tab-btn--yt"
            role="tab"
          >
            All on YouTube ↗
          </a>
        </div>
      </div>

      <!-- Sermon Archive Grid -->
      <div class="archive-grid">
        {monthGroups.map(group => (
          <div class="month-group" id={`month-${group.id}`}>
            <div class="month-header">
              <div class="month-label">
                <span class="month-short">{group.monthShort}</span>
                <span class="month-year">{group.year}</span>
              </div>
              <div class="month-meta">
                <span class="month-series">{group.month} {group.year}</span>
                <span class="month-count">{group.videos.length} messages</span>
              </div>
            </div>

            <div class="sermon-list">
              {group.videos.map(video => (
                <div class="sermon-row">
                  <div class="sermon-type" aria-label="Video">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <polygon points="23 7 16 12 23 17 23 7" /><rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
                    </svg>
                  </div>
                  <div class="sermon-row-info">
                    <p class="sermon-row-title">{video.title}</p>
                    <p class="sermon-row-pastor">
                      <span class="sermon-cat-pill">{video.category}</span>
                      {video.dateShort}{video.duration ? ` · ${video.duration}` : ''}
                    </p>
                  </div>
                  <a
                    href={video.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="sermon-row-listen"
                    aria-label={`Watch ${video.title} on YouTube`}
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <polygon points="5 3 19 12 5 21 5 3" />
                    </svg>
                  </a>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Subscribe CTA -->
  <section class="subscribe-section">
    <div class="container subscribe-inner">
      <div class="subscribe-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M18 8h1a4 4 0 0 1 0 8h-1" /><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
          <line x1="6" y1="1" x2="6" y2="4" /><line x1="10" y1="1" x2="10" y2="4" /><line x1="14" y1="1" x2="14" y2="4" />
        </svg>
      </div>
      <div class="subscribe-text">
        <h2 class="subscribe-heading">Never Miss a Message</h2>
        <p class="subscribe-sub">Subscribe to receive new sermons directly in your inbox each week.</p>
      </div>
      <form class="subscribe-form" name="sermon-subscribe" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <input type="email" name="email" placeholder="Your email address" aria-label="Email address for sermon subscription" />
        <button type="submit" class="btn btn-gold">Subscribe</button>
      </form>
    </div>
  </section>

  <script define:vars={{ serializedIndex }}>
    window.__ORAMA_INDEX__ = serializedIndex
  </script>

  <script>
import { search } from '@orama/orama'
import { restore } from '@orama/plugin-data-persistence'

// ── DOM refs ──────────────────────────────────────────────────────────────
const input = document.getElementById('sermon-search') as HTMLInputElement
const clearBtn = document.getElementById('search-clear') as HTMLButtonElement
const resultsPanel = document.getElementById('search-results-panel') as HTMLDivElement
const resultsList = document.getElementById('search-results-list') as HTMLDivElement
const resultsCount = document.getElementById('search-results-count') as HTMLParagraphElement
const noResults = document.getElementById('search-no-results') as HTMLParagraphElement
const tabsSection = document.querySelector('.tabs-container') as HTMLElement
const archiveGrid = document.querySelector('.archive-grid') as HTMLElement
const categoryPills = document.querySelectorAll<HTMLButtonElement>('.cat-pill')

// ── State ─────────────────────────────────────────────────────────────────
let db: Awaited<ReturnType<typeof restore>> | null = null
let dbReady: Promise<void> = Promise.resolve()
let activeCategory = ''
let lastQuery = ''

// ── Init: restore index ───────────────────────────────────────────────────
const raw = (window as any).__ORAMA_INDEX__
if (raw) {
  dbReady = restore('json', raw).then((instance) => {
    db = instance
  })
}

// ── Helpers ───────────────────────────────────────────────────────────────
function esc(s: string) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
}

function showMonthView() {
  resultsPanel.hidden = true
  tabsSection.hidden = false
  archiveGrid.hidden = false
}

function showSearchView() {
  resultsPanel.hidden = false
  tabsSection.hidden = true
  archiveGrid.hidden = true
}

function renderResults(hits: Array<{ document: Record<string, any> }>, query: string) {
  resultsCount.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'} for "${query}"`
  noResults.hidden = hits.length > 0

  if (hits.length === 0) {
    resultsList.innerHTML = ''
    return
  }

  resultsList.innerHTML = hits.map(({ document: v }) => `
        <div class="sermon-row">
          <div class="sermon-type" aria-label="Video">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
            </svg>
          </div>
          <div class="sermon-row-info">
            <p class="sermon-row-title">${esc(v.title)}</p>
            <p class="sermon-row-pastor">
              <span class="sermon-cat-pill">${esc(v.category)}</span>
              ${esc(v.dateShort)}${v.duration ? ` · ${esc(v.duration)}` : ''}
            </p>
          </div>
          <a
            href="${esc(v.url)}"
            target="_blank"
            rel="noopener noreferrer"
            class="sermon-row-listen"
            aria-label="Watch ${esc(v.title)} on YouTube"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
          </a>
        </div>
      `).join('')
}

async function runSearch(query: string) {
  await dbReady
  if (!db || !query.trim()) {
    showMonthView()
    return
  }

  showSearchView()

  const searchParams: Parameters<typeof search>[1] = {
    term: query,
    properties: ['title', 'description'],
    boost: { title: 2 },
    limit: 50,
  }

  if (activeCategory) {
    searchParams.where = { category: { eq: activeCategory } }
  }

  const results = await search(db, searchParams)
  renderResults(results.hits, query)
}

// ── Debounce ──────────────────────────────────────────────────────────────
let debounceTimer: ReturnType<typeof setTimeout>

input.addEventListener('input', () => {
  const query = input.value.trim()
  lastQuery = query
  clearBtn.hidden = query === ''

  clearTimeout(debounceTimer)
  debounceTimer = setTimeout(runSearch, 250, query)
})

// ── Clear button ──────────────────────────────────────────────────────────
clearBtn.addEventListener('click', () => {
  input.value = ''
  lastQuery = ''
  clearBtn.hidden = true
  showMonthView()
  input.focus()
})

// ── Category pills ────────────────────────────────────────────────────────
categoryPills.forEach((pill) => {
  pill.addEventListener('click', () => {
    activeCategory = pill.dataset.category ?? ''
    categoryPills.forEach(p => p.classList.toggle('cat-pill--active', p === pill))
    if (lastQuery)
      runSearch(lastQuery)
  })
})
</script>

  <Footer />
</Layout>

<style>
  /* Hero */
  .sermons-hero {
    background-color: var(--color-navy);
    position: relative;
    overflow: hidden;
    padding: 9rem 0 5.5rem;
    clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%);
    margin-bottom: -2rem;
  }

  .sermons-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 80%, rgba(224, 90, 43, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 20%, rgba(212, 168, 67, 0.08) 0%, transparent 50%);
  }

  .sermons-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
  }

  .sermons-hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .sermons-hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.7;
    max-width: 50ch;
  }

  /* Featured */
  .featured-section {
    background-color: var(--color-cream);
    padding: 5rem 0;
  }

  .featured-card {
    margin-top: 1.5rem;
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid rgba(13, 27, 62, 0.08);
    box-shadow: 0 8px 40px rgba(13, 27, 62, 0.08);
  }

  @media (min-width: 768px) {
    .featured-card {
      grid-template-columns: 320px 1fr;
    }
    .featured-thumb {
      min-height: 240px;
    }
  }

  .featured-thumb {
    position: relative;
    background: linear-gradient(135deg, var(--color-navy) 0%, #1a2d5a 100%);
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .featured-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .play-btn {
    position: relative;
    z-index: 2;
    width: 64px;
    height: 64px;
    background-color: var(--color-gold);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-navy);
    transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
    animation: pulse-glow 2.5s ease infinite;
    flex-shrink: 0;
    box-shadow: 0 0 0 6px rgba(0,0,0,0.35);
  }

  @media (hover: hover) and (pointer: fine) {
    .play-btn:hover {
      transform: scale(1.04);
      color: var(--color-navy);
    }
  }

  .play-btn:active {
    transform: scale(0.96);
  }

  .featured-info {
    padding: 2rem 2.5rem;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .featured-series {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .featured-sep {
    color: var(--color-muted);
  }

  .featured-date {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .featured-title {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--color-navy);
    margin-bottom: 0.375rem;
    line-height: 1.2;
  }

  .featured-pastor {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-coral);
    margin-bottom: 1rem;
  }

  .featured-desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 60ch;
  }

  .featured-scripture {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-navy);
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
  }

  .featured-scripture svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Archive */
  .archive-section {
    background-color: var(--color-white);
    padding: var(--section-padding) 0;
  }

  .archive-header {
    margin-bottom: 2.5rem;
  }

  .archive-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .archive-sub {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  /* ── Search bar ──────────────────────────────────── */
  .search-form {
    margin-bottom: 1.75rem;
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--color-muted);
    pointer-events: none;
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    padding: 0.875rem 3rem 0.875rem 2.75rem;
    border: 1.5px solid rgba(13, 27, 62, 0.15);
    border-radius: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text);
    background-color: var(--color-white);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    appearance: none;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.15);
  }

  .search-input::placeholder {
    color: var(--color-muted);
  }

  /* hide browser's built-in clear button */
  .search-input::-webkit-search-cancel-button { display: none; }

  .search-clear {
    position: absolute;
    right: 0.875rem;
    background: none;
    border: none;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0.25rem 0.375rem;
    border-radius: 0.25rem;
    transition: color var(--transition-base);
  }

  .search-clear:hover { color: var(--color-navy); }

  /* ── Search results panel ────────────────────────── */
  .search-results-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .search-results-count {
    font-size: 0.85rem;
    color: var(--color-muted);
    font-weight: 500;
    min-width: 12ch;
  }

  .search-category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .cat-pill {
    padding: 0.3rem 0.875rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 1.5px solid rgba(13, 27, 62, 0.15);
    border-radius: 2rem;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .cat-pill:hover {
    border-color: var(--color-navy);
    color: var(--color-navy);
  }

  .cat-pill--active {
    background-color: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-white);
  }

  .search-results-list {
    border: 1px solid rgba(13, 27, 62, 0.08);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .search-no-results {
