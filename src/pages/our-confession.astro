---
import Footer from '../components/footer.astro'
import Nav from '../components/nav.astro'
import Layout from '../layouts/Layout.astro'

const affirmations = [
  {
    title: 'On the Word of God',
    text: 'We affirm that the Holy Bible, consisting of the sixty-six canonical books of the Old and New Testaments, is the inspired, infallible, and inerrant Word of God. It is the only perfect and sufficient rule for faith and practice. We receive it not as the word of man but as it truly is — the Word of God, which effectually works in those who believe.',
  },
  {
    title: 'On the Holy Trinity',
    text: 'We affirm the eternal Godhead, existing in three co-equal, co-eternal, and co-substantial Persons: God the Father, God the Son, and God the Holy Spirit. These three are one in essence, distinct in person, and undivided in glory. There is no God before Him, beside Him, or after Him.',
  },
  {
    title: 'On the Lord Jesus Christ',
    text: 'We affirm that Jesus Christ is the eternal Son of God — fully divine and fully human. He was conceived by the Holy Spirit, born of the virgin Mary, lived without sin, suffered under Pontius Pilate, was crucified, died, and was buried. On the third day He rose bodily from the dead. He ascended to the right hand of the Father, and He will return in power and great glory to judge the living and the dead.',
  },
  {
    title: 'On the Holy Spirit',
    text: 'We affirm the full personality and deity of the Holy Spirit. He convicts the world of sin, righteousness, and judgement. He regenerates the believing soul, seals the redeemed unto the day of redemption, and baptises every believer into the body of Christ. He distributes spiritual gifts as He wills and produces His fruit in those who yield to His lordship.',
  },
  {
    title: 'On the Fall and the Redemption of Humanity',
    text: 'We affirm that Adam, the first man, was created in the image and likeness of God. By his wilful transgression, sin entered the world, and through sin, death — passing upon all men. Yet God, in His sovereign mercy, provided the remedy in the atoning death and triumphant resurrection of His Son, our Lord Jesus Christ. Salvation is freely offered to all who repent and believe.',
  },
  {
    title: 'On Salvation by Grace Through Faith',
    text: 'We affirm that salvation is the gift of God, received through repentance toward God and faith in the Lord Jesus Christ. It is not of works, lest any man should boast. The moment a person truly believes, they are born again, justified freely by His grace, adopted into God\'s family, and sealed by the Holy Spirit until the day of redemption.',
  },
  {
    title: 'On the Church',
    text: 'We affirm the one holy, universal, and apostolic Church — the body and bride of Christ, composed of all the redeemed of all ages. The local church is the visible, God-ordained expression of this body in the world, called to gather in worship, proclaim the Word, administer the sacraments, exercise godly discipline, and extend the mission of Christ to every nation.',
  },
  {
    title: 'On the Resurrection and Eternal Life',
    text: 'We affirm the bodily resurrection of the dead — the just to eternal life and the unjust to eternal condemnation. We affirm the glorious, visible, and personal return of our Lord Jesus Christ in power and great glory. We look for the redemption of our bodies, the renewal of all creation, and the consummation of all things in God through Christ Jesus our Lord.',
  },
];
---

<Layout
  title="Our Confession"
  description="The Apostolic Confession and Statement of Faith of Jesus House Jamaica — an RCCG parish in Kingston, Jamaica, grounded in historic, orthodox Christianity."
>
  <Nav heroDark={true} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="section-label">Statement of Faith</span>
      <h1 class="hero-title">Our Confession</h1>
      <p class="hero-sub">
        The foundational affirmations of Jesus House Jamaica — truths we hold, proclaim,
        and stake our lives upon.
      </p>
    </div>
  </section>

  <!-- Preamble -->
  <section class="preamble-section">
    <div class="container preamble-inner">
      <div class="preamble-card">
        <div class="preamble-ornament" aria-hidden="true">✦</div>
        <h2 class="preamble-heading">Apostolic Confession</h2>
        <p class="preamble-text">
          We, the members of Jesus House Jamaica — a parish of the Redeemed Christian Church of God —
          together confess and declare our faith in the eternal God who created all things, the Lord
          Jesus Christ who redeemed us, and the Holy Spirit who sanctifies and empowers us for godly
          living and global mission.
        </p>
        <p class="preamble-text">
          These affirmations are not the invention of men but the faithful testimony of the Holy
          Scriptures, received, believed, and proclaimed by the Church of Jesus Christ in every
          generation. We hold these truths not merely as theological positions, but as the living
          foundation upon which our entire community of faith is built.
        </p>
        <div class="preamble-divider" aria-hidden="true"></div>
        <p class="preamble-sub">
          "Now faith is the substance of things hoped for, the evidence of things not seen."
          <span>— Hebrews 11:1</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Affirmations -->
  <section class="affirmations-section">
    <div class="container affirmations-inner">
      <div class="affirmations-list">
        {affirmations.map((item, idx) => (
          <article class="affirmation">
            <div class="affirmation-num" aria-hidden="true">
              {String(idx + 1).padStart(2, '0')}
            </div>
            <div class="affirmation-body">
              <h2 class="affirmation-title">{item.title}</h2>
              <p class="affirmation-text">{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing Declaration -->
  <section class="declaration-section">
    <div class="container declaration-inner">
      <div class="declaration-card">
        <span class="section-label" style="display:block; text-align:center; margin-bottom:1.25rem;">Our Declaration</span>
        <h2 class="declaration-heading">Together We Confess</h2>
        <p class="declaration-text">
          As a community committed to the eternal Gospel, we do not hold these truths as options or
          preferences. They are the non-negotiable convictions by which we live, minister, and — when
          called upon — die. We confess them gladly, teach them faithfully, and invite all who seek
          the truth to examine them in the light of God's Holy Word.
        </p>
        <p class="declaration-text">
          We recognise that we are part of a great cloud of witnesses — men and women throughout
          history who have believed, suffered, and triumphed holding these very truths. We stand in
          their company, and we carry the torch forward to the generations who will come after us.
        </p>
        <div class="declaration-verse">
          "Earnestly contend for the faith which was once delivered unto the saints."
          <span>— Jude 1:3</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="confession-cta">
    <div class="container confession-cta-inner">
      <h2 class="cta-heading">Explore More About Our Faith</h2>
      <p class="cta-sub">Dive deeper into what we believe and why — through our beliefs page, our mission, or by coming to meet us in person.</p>
      <div class="cta-btns">
        <a href="/our-beliefs" class="btn btn-gold">Our Beliefs</a>
        <a href="/our-mission" class="btn btn-outline-navy">Our Mission</a>
        <a href="/contact" class="btn btn-outline-navy">Contact Us</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    background-color: var(--color-navy);
    position: relative;
    overflow: hidden;
    padding: 9rem 0 6rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 40%, rgba(212, 168, 67, 0.1) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 80%, rgba(224, 90, 43, 0.07) 0%, transparent 50%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 620px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.75;
    max-width: 50ch;
  }

  /* Preamble */
  .preamble-section {
    background-color: var(--color-cream);
    padding: var(--section-padding) 0;
  }

  .preamble-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .preamble-card {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid rgba(13, 27, 62, 0.08);
    text-align: center;
  }

  .preamble-ornament {
    font-size: 2rem;
    color: var(--color-gold);
    margin-bottom: 1.25rem;
    display: block;
    letter-spacing: 0.5em;
  }

  .preamble-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-navy);
    margin-bottom: 1.75rem;
  }

  .preamble-text {
    font-family: var(--font-accent);
    font-size: 1.025rem;
    color: var(--color-text);
    line-height: 1.85;
    margin-bottom: 1.25rem;
    text-align: left;
  }

  .preamble-divider {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-gold), var(--color-coral));
    margin: 2rem auto;
    border-radius: 2px;
  }

  .preamble-sub {
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    color: var(--color-navy);
    text-align: center;
  }

  .preamble-sub span {
    display: block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-top: 0.5rem;
    font-style: normal;
  }

  /* Affirmations */
  .affirmations-section {
    background-color: var(--color-white);
    padding: var(--section-padding) 0;
  }

  .affirmations-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .affirmations-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .affirmation {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 0 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(13, 27, 62, 0.08);
    align-items: start;
  }

  .affirmation:last-child {
    border-bottom: none;
  }

  @media (max-width: 600px) {
    .affirmation {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .affirmation-num {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    color: rgba(212, 168, 67, 0.18);
    line-height: 1;
    padding-top: 0.25rem;
  }

  .affirmation-title {
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    color: var(--color-navy);
    margin-bottom: 0.875rem;
    line-height: 1.25;
  }

  .affirmation-text {
    font-family: var(--font-accent);
    font-size: 0.995rem;
    color: var(--color-text);
    line-height: 1.85;
    max-width: 72ch;
  }

  /* Declaration */
  .declaration-section {
    background-color: var(--color-navy);
    padding: var(--section-padding) 0;
  }

  .declaration-inner {
    max-width: 780px;
    margin: 0 auto;
  }

  .declaration-card {
    text-align: center;
  }

  .declaration-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    color: var(--color-white);
    margin-bottom: 1.75rem;
  }

  .declaration-text {
    font-family: var(--font-accent);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.85;
    margin-bottom: 1.25rem;
    text-align: left;
  }

  .declaration-verse {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-gold);
    text-align: center;
    padding: 2rem;
    border: 1px solid rgba(212, 168, 67, 0.2);
    border-radius: var(--radius-card);
  }

  .declaration-verse span {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(212, 168, 67, 0.6);
    margin-top: 0.625rem;
    font-style: normal;
  }

  /* CTA */
  .confession-cta {
    background-color: var(--color-cream);
    padding: 5rem 0;
    text-align: center;
  }

  .confession-cta-inner {
    max-width: 580px;
    margin: 0 auto;
  }

  .cta-heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .cta-sub {
    font-size: 0.975rem;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  /* ── Mobile overrides ─────────────────────────────── */
  @media (max-width: 640px) {
    [class$="-hero"] { padding-top: 5.5rem; padding-bottom: 3.5rem; }
    [class*="-card"] { padding: 1.5rem 1.25rem; }
  }
</style>
