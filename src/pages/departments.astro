---
import Layout from '../layouts/Layout.astro'

const departments = [
  {
    name: 'Youth Ministry',
    tagline: 'A generation on fire for God.',
    leader: 'Pastor George Kamalu',
    meets: 'Saturdays · 4:00 PM',
    description: 'Our Youth Ministry is a vibrant, Spirit-filled community for young people aged 13–35. Through weekly gatherings, discipleship groups, community service projects, and the annual Youth Conference, we raise a generation that knows God deeply and serves boldly. Whether you are new to faith or a seasoned believer, you will find your tribe here.',
    highlights: ['Annual Youth Conference (August)', 'Weekly youth gathering', 'Campus outreach program', 'Leadership development track'],
    color: '#D4A843',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    name: 'Women\'s Fellowship',
    tagline: 'Rooted, empowered, and beautiful.',
    leader: 'Pastor Deborah Kamalu',
    meets: 'Second Saturday Monthly · 10:00 AM',
    description: 'The Women\'s Fellowship is a sisterhood unlike any other — a safe, nurturing space where women are seen, known, and equipped to walk in their God-given purpose. From quarterly retreats and mentorship programs to our powerful monthly meetings, we celebrate the strength, grace, and calling of every woman in our community.',
    highlights: ['Monthly fellowship meetings', 'Quarterly retreats', 'Mentorship program', 'Community outreach initiatives'],
    color: '#E05A2B',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><path d="M12 16v4M10 20h4"/></svg>`,
  },
  {
    name: 'Men\'s Ministry',
    tagline: 'Men of God. Men of character.',
    leader: 'Elder Samuel Barrett',
    meets: 'First Saturday Monthly · 7:00 AM',
    description: 'The Men\'s Ministry gathers men to grow in faith, build accountability, and serve as godly leaders in their homes, workplaces, and communities. Our early morning fellowship meetings — including prayer, discussion, and breakfast — have become a cornerstone of transformation for men across the congregation.',
    highlights: ['Monthly men\'s breakfast', 'Accountability groups', 'Marriage enrichment workshops', 'Annual men\'s retreat'],
    color: '#0D1B3E',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><line x1="19" y1="8" x2="23" y2="4"/><polyline points="20 4 23 4 23 7"/></svg>`,
  },
  {
    name: 'Children\'s Church',
    tagline: 'Little hearts, big faith.',
    leader: 'Deaconess Olivia Reynolds',
    meets: 'Sundays · 9:00 AM (concurrent)',
    description: 'While the adults gather in the main auditorium, our children experience their own vibrant, age-appropriate encounter with God. Through creative worship, engaging Bible lessons, crafts, and games, the Children\'s Church team makes Sunday the highlight of every child\'s week — planting seeds of faith that last a lifetime.',
    highlights: ['Sunday school (ages 3–12)', 'Vacation Bible School (July)', 'Children\'s Day celebration', 'Safe, vetted, trained volunteers'],
    color: '#D4A843',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  },
  {
    name: 'Media & Worship',
    tagline: 'Exalting God through sound and story.',
    leader: 'Music Director Kwame Asante',
    meets: 'Rehearsals: Thursdays 5:00 PM',
    description: 'The Media and Worship team is the creative heartbeat of Jesus House Jamaica. Our anointed worship leaders and musicians lead the congregation into God\'s presence every Sunday, while our media team manages sound engineering, video production, live streaming, and the management of our growing digital sermon archive.',
    highlights: ['Sunday worship team', 'Live streaming ministry', 'Sermon recording and archive', 'Social media and communications'],
    color: '#E05A2B',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  },
  {
    name: 'Prayer Team',
    tagline: 'The engine room of the church.',
    leader: 'Elder Marcus Thompson',
    meets: 'Thursdays · 6:00 PM',
    description: 'The Prayer Team is the spiritual foundation upon which everything at Jesus House Jamaica is built. These dedicated intercessors gather weekly to pray for the church, the community, and the nations. They also coordinate Night Vigil, Covenant Prayers, and special intercessory seasons — ensuring that everything we do flows from a place of deep prayer.',
    highlights: ['Weekly prayer meeting', 'Night Vigil coordination', 'Covenant Prayers leadership', 'Personal intercessory chain'],
    color: '#0D1B3E',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
  },
];
---

<Layout
  title="Departments"
  description="Explore the ministries and departments of Jesus House Jamaica — Youth Ministry, Women's Fellowship, Men's Ministry, Children's Church, Media & Worship, and Prayer Team."
>

  <!-- Hero -->
  <section class="dept-hero">
    <div class="dept-hero-bg" aria-hidden="true">
      <div class="hero-cross-v" aria-hidden="true"></div>
      <div class="hero-cross-h" aria-hidden="true"></div>
    </div>
    <div class="container dept-hero-inner">
      <span class="section-label">Ministry & Community</span>
      <h1 class="dept-hero-title">Ministries & Departments</h1>
      <p class="dept-hero-sub">
        There is a place for every gift, every passion, and every season of life.
        Find your people. Find your purpose.
      </p>
    </div>
  </section>

  <!-- Intro -->
  <section class="dept-intro">
    <div class="container dept-intro-inner">
      <blockquote class="dept-quote">
        Now you are the body of Christ, and each one of you is a part of it.
      </blockquote>
      <cite class="dept-cite">— 1 Corinthians 12:27</cite>
      <p class="dept-intro-text">
        At Jesus House Jamaica, we believe every member is a minister. Our departments are not programs —
        they are families within the family, each one carrying a distinct calling and gifting.
        Whether you are drawn to prayer, worship, service, or teaching, you belong here.
      </p>
    </div>
  </section>

  <!-- Departments -->
  <section class="departments-main">
    <div class="container">
      {departments.map((dept, i) => (
        <article class={`dept-article ${i % 2 !== 0 ? 'dept-article--reverse' : ''}`}>
          <div class="dept-visual" style={`--dept-color: ${dept.color}`}>
            <div class="dept-visual-bg"></div>
            <div class="dept-icon-large" aria-hidden="true" set:html={dept.icon} />
            <div class="dept-visual-name">{dept.name}</div>
          </div>
          <div class="dept-content">
            <span class="section-label">{dept.tagline}</span>
            <h2 class="dept-name">{dept.name}</h2>
            <div class="dept-meta">
              <div class="dept-meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
                <span>{dept.leader}</span>
              </div>
              <div class="dept-meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span>{dept.meets}</span>
              </div>
            </div>
            <p class="dept-desc">{dept.description}</p>
            <div class="dept-highlights">
              <p class="dept-highlights-label">Highlights</p>
              <ul class="dept-highlights-list">
                {dept.highlights.map(h => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {h}
                  </li>
                ))}
              </ul>
            </div>
            <a href="/contact" class="btn btn-gold">
              Get Involved
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="dept-cta">
    <div class="container dept-cta-inner">
      <h2 class="dept-cta-title">Ready to Find Your Place?</h2>
      <p class="dept-cta-sub">
        Come as you are. We will help you discover where you belong and how your gifts
        can serve the body of Christ.
      </p>
      <div class="dept-cta-btns">
        <a href="/contact" class="btn btn-gold">Contact Us</a>
        <a href="/contact#visit" class="btn btn-outline-white">Plan Your Visit</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .dept-hero {
    background-color: var(--color-navy);
    position: relative;
    overflow: hidden;
    padding: 9rem 0 5.5rem;
    clip-path: polygon(0 0, 100% 0, 100% 93%, 0 100%);
    margin-bottom: -1.5rem;
  }

  .dept-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 75% 50%, rgba(212, 168, 67, 0.08) 0%, transparent 60%);
  }

  .hero-cross-v {
    position: absolute;
    right: 15%;
    top: 15%;
    width: 1px;
    height: 220px;
    background: linear-gradient(to bottom, transparent, rgba(212, 168, 67, 0.12), transparent);
  }

  .hero-cross-h {
    position: absolute;
    right: calc(15% - 70px);
    top: calc(15% + 65px);
    width: 140px;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(212, 168, 67, 0.12), transparent);
  }

  .dept-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
  }

  .dept-hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .dept-hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.7;
    max-width: 50ch;
  }

  /* Intro */
  .dept-intro {
    background-color: var(--color-cream);
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .dept-intro-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .dept-quote {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    color: var(--color-navy);
    margin-bottom: 0.5rem;
    line-height: 1.4;
    quotes: none;
  }

  .dept-quote::before { content: '"'; color: var(--color-gold); }
  .dept-quote::after { content: '"'; color: var(--color-gold); }

  .dept-cite {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-style: normal;
    margin-bottom: 2rem;
  }

  .dept-intro-text {
    font-size: 0.975rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* Main departments */
  .departments-main {
    background-color: var(--color-white);
    padding: var(--section-padding) 0;
  }

  .dept-article {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 3.5rem 0;
    border-bottom: 1px solid rgba(13, 27, 62, 0.07);
  }

  .dept-article:last-child {
    border-bottom: none;
  }

  @media (min-width: 1024px) {
    .dept-article {
      grid-template-columns: 1fr 1.5fr;
      align-items: center;
    }

    .dept-article--reverse {
      grid-template-columns: 1.5fr 1fr;
    }

    .dept-article--reverse .dept-visual {
      order: 2;
    }

    .dept-article--reverse .dept-content {
      order: 1;
    }
  }

  /* Visual */
  .dept-visual {
    position: relative;
    height: 320px;
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .dept-visual-bg {
    position: absolute;
    inset: 0;
    background-color: var(--dept-color, var(--color-navy));
    opacity: 0.9;
  }

  .dept-visual-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
  }

  .dept-icon-large {
    position: relative;
    z-index: 2;
    color: rgba(255, 255, 255, 0.9);
    width: 80px;
    height: 80px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .dept-visual-name {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-white);
    text-align: center;
    padding: 0 1.5rem;
    line-height: 1.2;
  }

  /* Content */
  .dept-name {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .dept-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .dept-meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .dept-meta-item svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .dept-desc {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.75;
    margin-bottom: 1.5rem;
  }

  .dept-highlights {
    margin-bottom: 1.75rem;
  }

  .dept-highlights-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
  }

  .dept-highlights-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .dept-highlights-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .dept-highlights-list li svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  /* CTA */
  .dept-cta {
    background: linear-gradient(135deg, var(--color-navy) 0%, #1a2d5a 100%);
    padding: 5.5rem 0;
  }

  .dept-cta-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .dept-cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .dept-cta-sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }

  .dept-cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  /* ── Mobile overrides ─────────────────────────────── */
  @media (max-width: 640px) {
    .dept-card {
      padding: 1.5rem 1.25rem;
    }

    .dept-cta {
      padding: 3.5rem 0;
    }
  }
</style>
