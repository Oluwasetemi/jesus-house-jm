---
import InspirationAnimation from '../components/inspiration-animation.astro'
import rawVideos from '../data/videos.json'
import Layout from '../layouts/Layout.astro'

// 3 most recent Sunday services
const sermons = [...rawVideos]
  .filter(v => v.category === 'Sunday Service')
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3)
  .map(v => ({
    month: v.monthShort,
    title: v.title,
    category: v.category,
    date: v.dateNice,
    duration: v.duration,
    url: v.url,
    thumbnail: v.thumbnail,
  }))

const services = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    name: 'Sunday Service',
    time: 'Every Sunday · 9:00 AM',
    description: 'Our flagship weekly gathering — uplifting worship, powerful preaching, and Spirit-filled community.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    name: 'Good Morning Jesus',
    time: 'Every Monday · Early Morning',
    description: 'Start your week in prayer. Join the church family for GMJ — our Monday morning prayer gathering.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
    name: 'Prayer Meeting',
    time: 'Wednesday · 6:00 PM',
    description: 'Midweek prayer and communion service — corporate intercession, communion, and the Word of God.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
    name: 'Friday Bible Study',
    time: 'Every Friday · Online',
    description: 'Dive deep into the Word — verse-by-verse teaching, Q&A, and discussion. Fully online via Zoom.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    name: 'Youth Conference',
    time: 'Annual · August',
    description: 'A generation rising in faith. A dynamic conference that ignites passion in the hearts of young people.',
  },
]

const departments = [
  { name: 'Youth Ministry', icon: '✦', description: 'Empowering the next generation through faith, fellowship, and purpose-driven leadership.' },
  { name: 'Women\'s Fellowship', icon: '✦', description: 'A nurturing sisterhood where women are equipped, celebrated, and rooted in God\'s Word.' },
  { name: 'Men\'s Ministry', icon: '✦', description: 'Building men of integrity — spiritually strong, family-focused, and community-driven.' },
  { name: 'Children\'s Church', icon: '✦', description: 'A joyful, safe space where children discover Jesus and grow in faith from their earliest years.' },
  { name: 'Media & Worship', icon: '✦', description: 'Exalting God through music, production, and digital ministry to reach souls across the globe.' },
  { name: 'Prayer Team', icon: '✦', description: 'Interceding for the church, community, and nations. The engine room of our spiritual life.' },
];
---

<Layout
  title="Home"
  description="Jesus House Jamaica — A thriving RCCG community in the heart of Kingston, Jamaica. Join us every Sunday at 9:00 AM for worship, preaching, and community. Empowering men and women for godly living."
>

  <!-- Year Theme Banner -->
  <div class="year-theme-banner" role="banner" aria-label="2026 Church theme">
    <span class="year-theme-year">2026</span>
    <span class="year-theme-sep" aria-hidden="true">·</span>
    <span class="year-theme-text">Our Year of Greater Harvest</span>
    <a href="/our-confession" class="year-theme-link">Read the Declaration →</a>
  </div>

  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero" aria-label="Welcome to Jesus House Jamaica">
    <!-- Cross motif background decoration -->
    <div class="hero-cross-bg" aria-hidden="true">
      <div class="cross-v"></div>
      <div class="cross-h"></div>
    </div>

    <div class="hero-content-side">
      <div class="hero-inner container">
        <!-- Label -->
        <span class="section-label hero-label">Jesus House Jamaica · RCCG</span>

        <!-- Gold accent line -->
        <div class="hero-accent-line" aria-hidden="true"></div>

        <!-- Headline -->
        <h1 class="hero-headline">
          <span class="headline-normal">A Place to</span>
          <em class="headline-em">Encounter God</em>
        </h1>

        <!-- Subtext -->
        <p class="hero-subtext">
          Empowering men and women for godly living — join our community in Kingston, Jamaica.
          Every Sunday, we gather to worship, learn, and grow together in
          the love and grace of Jesus Christ.
        </p>

        <!-- CTAs -->
        <div class="hero-ctas">
          <a href="/contact#visit" class="btn btn-gold">
            Join Us Sunday
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/sermons" class="btn btn-outline-white">Watch Sermons</a>
        </div>

        <!-- Service badge -->
        <div class="hero-badge">
          <div class="badge-dot" aria-hidden="true"></div>
          <span>SUNDAYS 9:00 AM &nbsp;|&nbsp; RCCG</span>
        </div>
      </div>
    </div>

    <!-- Right photo side -->
    <div class="hero-photo-side" aria-label="Worship atmosphere">
      <div class="hero-photo-gradient"></div>
      <!-- Cross overlay — 3D rotating -->
      <div class="hero-cross-overlay" aria-hidden="true">
        <div class="cross-3d-scene">
          <div class="cross-3d-wrap">
            <svg class="cross-svg" width="160" height="224" viewBox="0 0 160 224" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="vBeam" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="white" stop-opacity="0" />
                  <stop offset="30%" stop-color="white" stop-opacity="0.7" />
                  <stop offset="50%" stop-color="white" stop-opacity="1" />
                  <stop offset="70%" stop-color="white" stop-opacity="0.7" />
                  <stop offset="100%" stop-color="white" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="hBeam" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="white" stop-opacity="0" />
                  <stop offset="30%" stop-color="white" stop-opacity="0.7" />
                  <stop offset="50%" stop-color="white" stop-opacity="1" />
                  <stop offset="70%" stop-color="white" stop-opacity="0.7" />
                  <stop offset="100%" stop-color="white" stop-opacity="0" />
                </linearGradient>
                <filter id="crossGlow">
                  <feGaussianBlur stdDeviation="4" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
              </defs>
              <!-- Glow layer -->
              <g filter="url(#crossGlow)" opacity="0.5">
                <rect x="66" y="8" width="28" height="208" rx="6" fill="white" />
                <rect x="8" y="76" width="144" height="28" rx="6" fill="white" />
              </g>
              <!-- Solid beam layer -->
              <rect x="66" y="8" width="28" height="208" rx="6" fill="url(#vBeam)" />
              <rect x="8" y="76" width="144" height="28" rx="6" fill="url(#hBeam)" />
            </svg>
          </div>
        </div>
      </div>
      <div class="hero-photo-text">
        <span>Kingston, Jamaica</span>
      </div>
    </div>

    <!-- Scroll indicator -->
    <a href="#welcome" class="scroll-indicator" aria-label="Scroll to welcome section">
      <div class="scroll-chevron"></div>
    </a>
  </section>

  <!-- ==================== WELCOME/ABOUT SECTION ==================== -->
  <section class="welcome-section" id="welcome" aria-label="Welcome to Jesus House Jamaica">
    <div class="container">
      <!-- Pull quote -->
      <blockquote class="welcome-pullquote">
        We are a community built on faith, love, and the Word of God.
      </blockquote>

      <!-- Scripture -->
      <p class="welcome-scripture">— Psalm 122:1</p>

      <!-- Two column text -->
      <div class="welcome-grid">
        <div class="welcome-col">
          <h2 class="welcome-heading">Rooted in Purpose, Growing in Grace</h2>
          <p>
            Jesus House Jamaica is more than a church — it is a spiritual home where every soul matters
            and every life is celebrated. As a proud parish of the Redeemed Christian Church of God (RCCG),
            we are part of one of the fastest-growing churches in the world, yet our heart remains
            deeply local — anchored in the community of Kingston, Jamaica.
          </p>
        </div>
        <div class="welcome-col">
          <p>
            Our mission is to make heaven and to take as many people with us as possible. We believe
            in the transforming power of the Holy Spirit, the absolute authority of the Scriptures,
            and the joy of gathering together as the body of Christ. Whether you are taking your first
            step of faith or have walked with God for decades, there is a place for you here.
          </p>
          <a href="/about" class="btn btn-outline-navy" style="margin-top: 1.5rem;">
            Learn Our Story
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SERVICES SECTION ==================== -->
  <section class="services-section" aria-label="What we offer">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Join Us</span>
        <h2 class="section-heading">What We Offer</h2>
        <p class="section-subheading">
          From Sunday worship to weekly growth, there is always a reason to gather.
        </p>
      </div>

      <div class="services-grid">
        {services.map(service => (
          <div class="service-card">
            <div class="service-card-top-border" aria-hidden="true"></div>
            <div class="service-icon" aria-hidden="true" set:html={service.icon} />
            <h3 class="service-name">{service.name}</h3>
            <p class="service-time">{service.time}</p>
            <p class="service-desc">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== SERMONS SECTION ==================== -->
  <section class="sermons-section" aria-label="Recent messages">
    <div class="container">
      <div class="section-header section-header--light">
        <span class="section-label">Recent Messages</span>
        <h2 class="section-heading section-heading--light">The Word, Delivered</h2>
        <p class="section-subheading section-subheading--light">
          Miss a service? Catch up with our latest sermons.
        </p>
      </div>

      <div class="sermons-grid">
        {sermons.map(sermon => (
          <article class="sermon-card">
            <a
              href={sermon.url}
              target="_blank"
              rel="noopener noreferrer"
              class="sermon-thumb-link"
              aria-label={`Watch ${sermon.title} on YouTube`}
              tabindex="-1"
            >
              <div class="sermon-thumb">
                <img
                  src={sermon.thumbnail}
                  alt={sermon.title}
                  loading="lazy"
                  width="320"
                  height="180"
                />
                <div class="sermon-thumb-play" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3" />
                  </svg>
                </div>
                {sermon.duration && (
                  <span class="sermon-thumb-dur">{sermon.duration}</span>
                )}
              </div>
            </a>
            <div class="sermon-body">
              <div class="sermon-month-label">{sermon.month}</div>
              <div class="sermon-series">{sermon.category}</div>
              <h3 class="sermon-title">{sermon.title}</h3>
              <p class="sermon-pastor">Pastor George Kamalu</p>
              <p class="sermon-date">{sermon.date}</p>
              <a
                href={sermon.url}
                target="_blank"
                rel="noopener noreferrer"
                class="sermon-listen"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none" />
                </svg>
                Watch Now
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="sermons-cta">
        <a href="/sermons" class="btn btn-outline-white">
          View All Sermons
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== DEPARTMENTS SECTION ==================== -->
  <section class="departments-section" aria-label="Ministry departments">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Get Involved</span>
        <h2 class="section-heading">Ministries & Departments</h2>
        <p class="section-subheading">
          There is a place for every gift, every passion, and every season of life.
        </p>
      </div>

      <div class="departments-grid">
        {departments.map(dept => (
          <div class="dept-card">
            <div class="dept-icon" aria-hidden="true">{dept.icon}</div>
            <h3 class="dept-name">{dept.name}</h3>
            <p class="dept-desc">{dept.description}</p>
          </div>
        ))}
      </div>

      <div class="departments-cta">
        <a href="/departments" class="btn btn-gold">
          Explore All Ministries
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== CONTACT / VISIT CTA SECTION ==================== -->
  <section class="visit-section" aria-label="Plan your visit">
    <div class="visit-left">
      <div class="visit-left-inner">
        <span class="section-label">Find Us</span>
        <h2 class="visit-heading">Plan Your Visit</h2>

        <div class="visit-info">
          <div class="visit-info-item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <div>
              <strong>Address</strong>
              <a href="https://maps.google.com/?q=3+McGregor+Square,+corner+of+Beechwood+Avenue,+off+Halfway+Tree,+Kingston+5,+Jamaica" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:underline;text-underline-offset:3px;">
                3 McGregor Square, corner of Beechwood Ave,<br />off Halfway Tree, Kingston 5, Jamaica
              </a>
            </div>
          </div>

          <div class="visit-info-item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <div>
              <strong>Service Times</strong>
              <p>Sunday: 9:00 AM<br />Mon: Good Morning Jesus · Wed: Prayer Meeting 6:00 PM<br />Fri: Bible Study (Online)</p>
            </div>
          </div>

          <div class="visit-info-item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38a2 2 0 0 1 1.99-2.18H6.6a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.94-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <div>
              <strong>Phone</strong>
              <a href="tel:+18769202260" style="color:inherit;text-decoration:underline;text-underline-offset:3px;">+1 876 920 2260</a>
            </div>
          </div>
        </div>

        <!-- Map placeholder -->
        <div class="map-placeholder" aria-label="Map placeholder — 3 McGregor Square, Kingston 5, Jamaica">
          <div class="map-inner">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>Kingston, Jamaica</span>
          </div>
        </div>
      </div>
    </div>

    <div class="visit-right" id="visit">
      <div class="visit-right-inner">
        <h3 class="visit-form-title">We'd Love to Meet You</h3>
        <p class="visit-form-sub">Fill in your details and a member of our team will be in touch.</p>

        <form class="visit-form" name="plan-visit" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>
          <div class="form-row">
            <div class="form-group">
              <label for="hero-fname">First Name</label>
              <input type="text" id="hero-fname" name="first_name" placeholder="Grace" required autocomplete="given-name" />
            </div>
            <div class="form-group">
              <label for="hero-lname">Last Name</label>
              <input type="text" id="hero-lname" name="last_name" placeholder="Wilson" required autocomplete="family-name" />
            </div>
          </div>

          <div class="form-group">
            <label for="hero-email">Email Address</label>
            <input type="email" id="hero-email" name="email" placeholder="your@email.com" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="hero-interest">I am interested in</label>
            <select id="hero-interest" name="interest">
              <option value="">— Select —</option>
              <option value="first-visit">Planning My First Visit</option>
              <option value="membership">Church Membership</option>
              <option value="counseling">Pastoral Counseling</option>
              <option value="ministry">Joining a Ministry</option>
              <option value="prayer">Prayer Request</option>
              <option value="other">Other</option>
            </select>
          </div>

          <button type="submit" class="btn btn-gold" style="width: 100%; justify-content: center;">
            Send Message
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Inspiration Animation -->
  <InspirationAnimation />

</Layout>

<style>
  /* ===== YEAR THEME BANNER ===== */
  .year-theme-banner {
    background-color: var(--color-gold);
    color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 0.6rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .year-theme-year {
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .year-theme-sep {
    opacity: 0.5;
  }

  .year-theme-text {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .year-theme-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 0.75;
    transition: opacity var(--transition-base);
  }

  .year-theme-link:hover {
    opacity: 1;
    color: var(--color-navy);
  }

  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    background-color: var(--color-navy);
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Cross background motif */
  .hero-cross-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .cross-v {
    position: absolute;
    left: 42%;
    top: 10%;
    width: 1px;
    height: 300px;
    background: linear-gradient(to bottom, transparent, rgba(212, 168, 67, 0.15), transparent);
  }

  .cross-h {
    position: absolute;
    left: calc(42% - 80px);
    top: calc(10% + 80px);
    width: 160px;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(212, 168, 67, 0.15), transparent);
  }

  /* Content side */
  .hero-content-side {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    padding: 7rem 0 5rem;
    background-color: var(--color-navy);
    clip-path: none;
  }

  @media (min-width: 1024px) {
    .hero-content-side {
      clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
      padding-right: 5%;
    }
  }

  .hero-inner {
    max-width: 640px;
  }

  .hero-label {
    animation: fadeInUp 0.45s var(--ease-out) both;
  }

  .hero-accent-line {
    width: 72px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-gold), var(--color-coral));
    margin-bottom: 1.5rem;
    border-radius: 2px;
    animation: fadeInUp 0.45s 0.07s var(--ease-out) both;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 1.08;
    color: var(--color-white);
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.5s 0.12s var(--ease-out) both;
  }

  .headline-normal {
    display: block;
    font-weight: 400;
  }

  .headline-em {
    display: block;
    font-style: italic;
    font-weight: 900;
    color: var(--color-gold);
  }

  .hero-subtext {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 46ch;
    line-height: 1.7;
    margin-bottom: 2.25rem;
    animation: fadeInUp 0.5s 0.2s var(--ease-out) both;
  }

