---
import { getCollection, render } from 'astro:content'
import rawEpisodes from '../../data/podcast.json'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const noteEntries = await getCollection('podcast')
  return noteEntries
    .filter(e => e.data.episodeNumber != null)
    .map(e => ({ params: { episodeNumber: String(e.data.episodeNumber) } }))
}

const { episodeNumber } = Astro.params
const epNum = Number(episodeNumber)

const noteEntries = await getCollection('podcast')
const entry = noteEntries.find(e => e.data.episodeNumber === epNum)
const ep = rawEpisodes.find(e => e.episodeNumber === epNum)

if (!entry || !ep) {
  return Astro.redirect('/podcast')
}

const { Content } = await render(entry)
const isPremiered = Boolean(ep.duration)
const basePath = `/podcast/${episodeNumber}`
const audioSrc = (ep as any).audio as string | undefined
---

<Layout
  title={`${ep.title} — In The Pews`}
  description={`Show notes for ${ep.title}, a Jesus House Jamaica podcast episode.`}
  heroDark={true}
>

  <!-- ── Episode Header ───────────────────────────── -->
  <section class="ep-hero">
    <div class="container ep-hero-inner">
      <a href="/podcast" class="back-link">← All Episodes</a>
      <div class="ep-badges">
        <span class="ep-badge">Ep {ep.episodeNumber}</span>
        {!isPremiered && (
          <span class="ep-badge ep-badge--premiere">Premieres {ep.dateNice}</span>
        )}
      </div>
      <h1 class="ep-title">{ep.title}</h1>
      <p class="ep-meta">{ep.dateNice}{ep.duration ? ` · ${ep.duration}` : ''}</p>
    </div>
  </section>

  <!-- ── Video ────────────────────────────────────── -->
  <section class="video-section">
    <div class="container">
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${ep.id}`}
          title={ep.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="eager"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ── Audio Player ────────────────────────────── -->
  {audioSrc && isPremiered && (
    <section class="audio-section">
      <div class="container">
        <div class="audio-player">
          <div class="audio-player-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            Listen to Episode {ep.episodeNumber}
          </div>
          <audio controls preload="metadata" class="audio-el">
            <source src={audioSrc} type="audio/mpeg" />
            Your browser does not support the audio element.
          </audio>
        </div>
      </div>
    </section>
  )}

  <!-- ── Tabs ─────────────────────────────────────── -->
  <section class="tabs-section">
    <div class="container">
      <nav class="tabs" aria-label="Episode content">
        <a href={basePath} class="tab tab--active">Show Notes</a>
        <a href={`${basePath}/transcript`} class="tab">Transcript</a>
      </nav>
    </div>
  </section>

  <!-- ── Show Notes Body ──────────────────────────── -->
  <section class="notes-section">
    <div class="container notes-container">

      {entry.data.topics.length > 0 && (
        <div class="topics">
          <span class="topics-label">Topics</span>
          <ul class="topics-list">
            {entry.data.topics.map(t => (
              <li class={`topic-pill${!isPremiered ? ' topic-pill--muted' : ''}`}>{t}</li>
            ))}
          </ul>
        </div>
      )}

      {!isPremiered ? (
        <div class="coming-soon">
          <div class="coming-soon-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <p class="coming-soon-heading">Show Notes Coming Soon</p>
          <p class="coming-soon-sub">
            Full episode notes will be published when this episode premieres on <strong>{ep.dateNice}</strong>.
            Subscribe on YouTube so you don't miss it.
          </p>
          <a
            href={ep.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-gold"
          >
            Set a Reminder on YouTube →
          </a>
        </div>
      ) : (
        <div class="notes-body">
          <Content />
        </div>
      )}
    </div>
  </section>

  <!-- ── Episode Nav ──────────────────────────────── -->
  <section class="ep-nav-section">
    <div class="container ep-nav">
      {epNum > 1 && (
        <a href={`/podcast/${epNum - 1}`} class="ep-nav-link ep-nav-link--prev">
          ← Episode {epNum - 1}
        </a>
      )}
      {rawEpisodes.find(e => e.episodeNumber === epNum + 1) && (
        <a href={`/podcast/${epNum + 1}`} class="ep-nav-link ep-nav-link--next">
          Episode {epNum + 1} →
        </a>
      )}
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ──────────────────────────────────────── */
  .ep-hero {
    background-color: var(--color-navy);
    padding: var(--section-padding) 0 2rem;
  }

  .ep-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 800px;
  }

  .back-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover { color: var(--color-gold); }

  .ep-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ep-badge {
    display: inline-block;
    background-color: var(--color-gold);
    color: var(--color-navy);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .ep-badge--premiere {
    background-color: var(--color-coral);
    color: var(--color-white);
  }

  .ep-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--color-white);
    line-height: 1.1;
  }

  .ep-meta {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ── Video ─────────────────────────────────────── */
  .video-section {
    background-color: var(--color-navy);
    padding-bottom: 0;
  }

  .video-embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background-color: #000;
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── Audio Player ─────────────────────────────── */
  .audio-section {
    background-color: var(--color-navy);
    padding: 1.25rem 0 0;
  }

  .audio-player {
    max-width: 800px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .audio-player-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .audio-el {
    width: 100%;
    height: 40px;
    accent-color: var(--color-gold);
    border-radius: 4px;
  }

  /* ── Tabs ──────────────────────────────────────── */
  .tabs-section {
    background-color: var(--color-cream);
    border-bottom: 3px solid var(--color-gold);
  }

  .tabs {
    display: flex;
    gap: 0;
    max-width: 800px;
    padding-top: 1.25rem;
  }

  .tab {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    border-radius: 5px 5px 0 0;
    transition: background-color 0.15s ease, color 0.15s ease;
    position: relative;
    bottom: -3px;
  }

  .tab:hover {
    color: var(--color-navy);
    background-color: rgba(212, 168, 67, 0.12);
  }

  .tab--active {
    background-color: var(--color-gold);
    color: var(--color-navy);
    border-bottom: 3px solid var(--color-gold);
  }

  .tab--active:hover {
    background-color: var(--color-gold);
    color: var(--color-navy);
  }

  /* ── Notes ─────────────────────────────────────── */
  .notes-section {
    background-color: var(--color-cream);
    padding: 2.5rem 0 var(--section-padding);
  }

  .notes-container {
    max-width: 800px;
  }

  .topics {
    margin-bottom: 2rem;
  }

  .topics-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .topics-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .topic-pill {
    background-color: rgba(212, 168, 67, 0.15);
    color: var(--color-navy);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 168, 67, 0.35);
  }

  .topic-pill--muted { opacity: 0.5; }

  .notes-body {
    color: var(--color-text);
    line-height: 1.8;
  }

  .notes-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-navy);
    margin: 2rem 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(44, 24, 16, 0.1);
  }

  .notes-body :global(h3) {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-navy);
    margin: 1.5rem 0 0.4rem;
  }

  .notes-body :global(p) {
    margin-bottom: 1rem;
  }

  /* ── Coming Soon ───────────────────────────────── */
  .coming-soon {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 560px;
    padding-top: 1rem;
  }

  .coming-soon-icon { color: var(--color-gold); }

  .coming-soon-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .coming-soon-sub {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* ── Episode Nav ───────────────────────────────── */
  .ep-nav-section {
    padding: 2rem 0;
    background-color: var(--color-white);
    border-top: 1px solid rgba(44, 24, 16, 0.08);
  }

  .ep-nav {
    display: flex;
    justify-content: space-between;
    max-width: 800px;
  }

  .ep-nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .ep-nav-link:hover { color: var(--color-gold); }

  .ep-nav-link--next { margin-left: auto; }
</style>
