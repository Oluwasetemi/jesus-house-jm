---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';

const departments = [
  'General Enquiry',
  'Pastoral Counseling',
  'Prayer Request',
  'Youth Ministry',
  "Women's Fellowship",
  "Men's Ministry",
  "Children's Church",
  'Media & Worship',
  'Events & Conferences',
  'Membership',
  'Tithes & Giving',
  'Technical / Website',
];

const serviceTimes = [
  { name: 'Sunday Service', time: '9:00 AM', note: 'Main auditorium — all ages welcome' },
  { name: 'Children\'s Church', time: '9:00 AM', note: 'Concurrent with Sunday Service' },
  { name: 'Good Morning Jesus', time: 'Every Monday · Early Morning', note: 'Monday morning prayer — GMJ' },
  { name: 'Prayer Meeting', time: 'Wednesday · 6:00 PM', note: 'Corporate intercession & communion service' },
  { name: 'Friday Bible Study', time: 'Every Friday · Online', note: 'Interactive teaching via Zoom' },
];
---

<Layout
  title="Contact"
  description="Get in touch with Jesus House Jamaica — find our address, service times, contact form, and book an appointment for pastoral counseling."
>
  <Nav />

  <!-- Hero -->
  <section class="contact-hero">
    <div class="contact-hero-bg" aria-hidden="true"></div>
    <div class="container contact-hero-inner">
      <span class="section-label">We're Here for You</span>
      <h1 class="contact-hero-title">Get in Touch</h1>
      <p class="contact-hero-sub">
        Whether you have a question, a prayer request, or simply want to find your
        way to Jesus House Jamaica — we would love to hear from you.
      </p>
    </div>
  </section>

  <!-- Quick contact cards -->
  <section class="quick-contact">
    <div class="container quick-contact-grid">
      <a href="tel:+18769202260" class="quick-card">
        <div class="quick-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38a2 2 0 0 1 1.99-2.18H6.6a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.94-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <div>
          <p class="quick-label">Call Us</p>
          <p class="quick-value">+1 876 920 2260</p>
        </div>
      </a>

      <a href="mailto:jesushousekgn@hotmail.com" class="quick-card">
        <div class="quick-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div>
          <p class="quick-label">Email Us</p>
          <p class="quick-value">jesushousekgn@hotmail.com</p>
        </div>
      </a>

      <a href="https://maps.google.com/?q=3+McGregor+Square,+corner+of+Beechwood+Avenue,+off+Halfway+Tree,+Kingston+5,+Jamaica" target="_blank" rel="noopener noreferrer" class="quick-card">
        <div class="quick-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <p class="quick-label">Visit Us</p>
          <p class="quick-value">3 McGregor Square, Kingston 5</p>
        </div>
      </a>

      <div class="quick-card">
        <div class="quick-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div>
          <p class="quick-label">Sunday Service</p>
          <p class="quick-value">9:00 AM every Sunday</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main contact area -->
  <section class="main-contact" id="visit">
    <div class="contact-map-col">
      <div class="contact-map-inner">
        <span class="section-label">Location</span>
        <h2 class="contact-location-title">Find Jesus House Jamaica</h2>

        <!-- Google Maps embed -->
        <a
          href="https://maps.google.com/?q=3+McGregor+Square,+corner+of+Beechwood+Avenue,+off+Halfway+Tree,+Kingston+5,+Jamaica"
          target="_blank"
          rel="noopener noreferrer"
          class="map-area"
          aria-label="Open in Google Maps — 3 McGregor Square, Kingston 5, Jamaica"
        >
          <div class="map-gradient"></div>
          <div class="map-pin-overlay" aria-hidden="true">
            <div class="map-pin">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" fill="#D4A843"/>
                <circle cx="12" cy="10" r="3" fill="#0D1B3E"/>
              </svg>
              <div class="map-pin-label">Jesus House Jamaica</div>
            </div>
          </div>
          <div class="map-open-hint">Open in Google Maps ↗</div>
        </a>

        <!-- Address block -->
        <div class="contact-address">
          <div class="address-row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <div>
              <strong>Address</strong>
              <a href="https://maps.google.com/?q=3+McGregor+Square,+corner+of+Beechwood+Avenue,+off+Halfway+Tree,+Kingston+5,+Jamaica" target="_blank" rel="noopener noreferrer" class="addr-link">
                3 McGregor Square, corner of Beechwood Avenue,<br/>off Halfway Tree, Kingston 5, Jamaica
              </a>
            </div>
          </div>

          <div class="address-row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38a2 2 0 0 1 1.99-2.18H6.6a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.94-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <div>
              <strong>Phone</strong>
              <a href="tel:+18769202260" class="addr-link">+1 876 920 2260</a>
            </div>
          </div>

          <div class="address-row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <div>
              <strong>Email</strong>
              <a href="mailto:jesushousekgn@hotmail.com" class="addr-link">jesushousekgn@hotmail.com</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="contact-form-col">
      <div class="contact-form-inner">
        <span class="section-label">Send a Message</span>
        <h2 class="contact-form-title">We'd Love to Hear from You</h2>
        <p class="contact-form-sub">Our team responds within 1–2 business days.</p>

        <form class="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <div class="form-row">
            <div class="form-group">
              <label for="cf-fname">First Name <span aria-label="required">*</span></label>
              <input type="text" id="cf-fname" name="first_name" placeholder="Grace" required autocomplete="given-name" />
            </div>
            <div class="form-group">
              <label for="cf-lname">Last Name <span aria-label="required">*</span></label>
              <input type="text" id="cf-lname" name="last_name" placeholder="Wilson" required autocomplete="family-name" />
            </div>
          </div>

          <div class="form-group">
            <label for="cf-email">Email Address <span aria-label="required">*</span></label>
            <input type="email" id="cf-email" name="email" placeholder="your@email.com" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="cf-phone">Phone Number</label>
            <input type="tel" id="cf-phone" name="phone" placeholder="+1 (876) 000-0000" autocomplete="tel" />
          </div>

          <div class="form-group">
            <label for="cf-dept">Department / Topic <span aria-label="required">*</span></label>
            <select id="cf-dept" name="department" required>
              <option value="">— Select a Department —</option>
              {departments.map((dept) => (
                <option value={dept.toLowerCase().replace(/\s+/g, '-')}>{dept}</option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label for="cf-message">Your Message <span aria-label="required">*</span></label>
            <textarea id="cf-message" name="message" rows="5" placeholder="How can we help you?" required></textarea>
          </div>

          <button type="submit" class="btn btn-gold" style="width:100%; justify-content:center;">
            Send Message
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Service Times -->
  <section class="service-times-section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">When We Gather</span>
        <h2 class="section-heading">Service Times</h2>
      </div>
      <div class="times-grid">
        {serviceTimes.map((s) => (
          <div class="time-card">
            <div class="time-card-left">
              <div class="time-dot" aria-hidden="true"></div>
              <h3 class="time-name">{s.name}</h3>
            </div>
            <div class="time-card-right">
              <p class="time-value">{s.time}</p>
              <p class="time-note">{s.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Appointment Booking -->
  <section class="appointment-section" id="appointment">
    <div class="container appointment-inner">
      <div class="appointment-text">
        <span class="section-label">Pastoral Counseling</span>
        <h2 class="appointment-title">Book an Appointment</h2>
        <p class="appointment-sub">
          Our pastoral team is available for one-on-one counseling, pre-marital preparation,
          spiritual direction, and prayer. All sessions are confidential, compassionate, and free.
        </p>
        <ul class="appointment-list">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Spiritual counseling and mentorship
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Pre-marital counseling
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Grief and crisis support
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            New members consultation
          </li>
        </ul>
      </div>

      <div class="appointment-form-wrap">
        <h3 class="appt-form-title">Schedule a Meeting</h3>
        <form class="appt-form" name="appointment" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <div class="form-group">
            <label for="appt-name">Full Name <span aria-label="required">*</span></label>
            <input type="text" id="appt-name" name="name" placeholder="Grace Wilson" required autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="appt-email">Email <span aria-label="required">*</span></label>
            <input type="email" id="appt-email" name="email" placeholder="your@email.com" required />
          </div>

          <div class="form-group">
            <label for="appt-phone">Phone</label>
            <input type="tel" id="appt-phone" name="phone" placeholder="+1 (876) 000-0000" />
          </div>

          <div class="form-group">
            <label for="appt-type">Type of Appointment <span aria-label="required">*</span></label>
            <select id="appt-type" name="appointment_type" required>
              <option value="">— Select —</option>
              <option value="spiritual">Spiritual Counseling</option>
              <option value="pre-marital">Pre-Marital Counseling</option>
              <option value="grief">Grief Support</option>
              <option value="new-member">New Member Consultation</option>
              <option value="general">General Pastoral Meeting</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="appt-date">Preferred Date <span aria-label="required">*</span></label>
              <input type="date" id="appt-date" name="preferred_date" required />
            </div>
            <div class="form-group">
              <label for="appt-time">Preferred Time</label>
              <select id="appt-time" name="preferred_time">
                <option value="">— Select —</option>
                <option value="morning">Morning (9–12 PM)</option>
                <option value="afternoon">Afternoon (12–5 PM)</option>
                <option value="evening">Evening (5–7 PM)</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="appt-notes">Brief Description</label>
            <textarea id="appt-notes" name="notes" rows="3" placeholder="Briefly describe what you would like to discuss (optional)"></textarea>
          </div>

          <button type="submit" class="btn btn-coral" style="width:100%; justify-content:center;">
            Request Appointment
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .contact-hero {
    background-color: var(--color-navy);
    position: relative;
    overflow: hidden;
    padding: 9rem 0 5.5rem;
  }

  .contact-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 40%, rgba(212, 168, 67, 0.07) 0%, transparent 60%);
  }

  .contact-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
  }

  .contact-hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .contact-hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.7;
    max-width: 52ch;
  }

  /* Quick contact */
  .quick-contact {
    background-color: var(--color-cream);
    padding: 3rem 0;
  }

  .quick-contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .quick-contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .quick-contact-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .quick-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid rgba(13, 27, 62, 0.07);
    transition: border-color var(--transition-base), transform 0.2s ease;
  }

  a.quick-card:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
    color: var(--color-text);
  }

  .quick-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background-color: rgba(212, 168, 67, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold);
  }

  .quick-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.125rem;
  }

  .quick-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
  }

  /* Main contact split */
  .main-contact {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 700px;
  }

  @media (min-width: 1024px) {
    .main-contact {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-map-col {
    background-color: var(--color-navy);
    padding: 4rem var(--container-px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .contact-map-inner {
    max-width: 480px;
    width: 100%;
  }

  .contact-location-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-white);
    margin-bottom: 2rem;
  }

  .map-area {
    position: relative;
    height: 280px;
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: 2rem;
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .map-area:hover .map-open-hint { opacity: 1; }

  .map-open-hint {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(13,27,62,0.85);
    color: var(--color-gold);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .addr-link {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.9rem;
    line-height: 1.5;
    display: block;
    margin-top: 0.15rem;
    transition: color var(--transition-base);
  }

  .addr-link:hover { color: var(--color-gold); }

  .map-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      #1a3a6c 0%,
      #234d8a 25%,
      #1e6b5c 50%,
      #2d6b35 75%,
      #4a8a2a 100%
    );
    opacity: 0.85;
  }

  .map-pin-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-pin {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .map-pin-label {
    background-color: var(--color-white);
    color: var(--color-navy);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .contact-address {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .address-row {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    color: rgba(255, 255, 255, 0.75);
  }

  .address-row svg {
    flex-shrink: 0;
    color: var(--color-gold);
    margin-top: 2px;
  }

  .address-row strong {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.125rem;
  }

  .address-row p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }

  /* Contact form col */
  .contact-form-col {
    background-color: var(--color-cream);
    padding: 4rem var(--container-px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .contact-form-inner {
    max-width: 480px;
    width: 100%;
  }

  .contact-form-title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .contact-form-sub {
    font-size: 0.9rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-navy);
    text-transform: uppercase;
  }

  .form-group label span {
    color: var(--color-coral);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1.5px solid rgba(13, 27, 62, 0.15);
    border-radius: 0.375rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text);
    background-color: var(--color-white);
    transition: border-color var(--transition-base);
    -webkit-appearance: none;
    appearance: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.15);
  }

