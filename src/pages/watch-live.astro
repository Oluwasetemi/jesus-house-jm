---
import Footer from '../components/footer.astro'
import Nav from '../components/nav.astro'
import rawVideos from '../data/videos.json'
import Layout from '../layouts/Layout.astro'

const CHANNEL_ID = 'UCO1S3nxtFg0_HXEMuZji5zg'
const YOUTUBE_CHANNEL = 'https://www.youtube.com/@jesushousekingston/streams'
const YOUTUBE_LIVE = `https://www.youtube.com/embed/live_stream?channel=${CHANNEL_ID}&autoplay=1&enablejsapi=1&origin=${Astro.site}`

// 6 most recent videos from real data
const recentSermons = [...rawVideos]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6)
  .map(v => ({ title: v.title, date: v.dateShort, id: v.id, category: v.category, thumbnail: v.thumbnail }))

const onlineMeetings = [
  {
    name: 'Good Morning Jesus',
    day: 'Every Monday',
    time: 'Early Morning Jamaica Time',
    zoom: 'zoommtg://zoom.us/join?confno=8763456789',
    zoomDisplay: '876 345 6789',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`,
  },
  {
    name: 'Prayer Meeting',
    day: 'Every Wednesday',
    time: '6:00 PM Jamaica Time',
    zoom: 'zoommtg://zoom.us/join?confno=8761234567',
    zoomDisplay: '876 123 4567',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
  },
  {
    name: 'Friday Bible Study',
    day: 'Every Friday',
    time: 'Online via Zoom',
    zoom: 'zoommtg://zoom.us/join?confno=8769876543',
    zoomDisplay: '876 987 6543',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
];
---

<Layout
  title="Watch Live"
  description="Watch Jesus House Jamaica live on YouTube. Stream Sunday services, Good Morning Jesus (Monday), Wednesday Prayer Meeting, Friday Bible Study, and special events online."
>
  <Nav heroDark={true} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <!-- shown/hidden by live-detector.js -->
      <p class="section-label live-label" id="live-badge" style="display:none">
        <span class="live-pulse" aria-hidden="true"></span>
        WE'RE LIVE
      </p>
      <p class="section-label offline-label" id="offline-badge">
        WATCH LIVE
      </p>
      <h1 class="hero-title">Watch Live</h1>
      <p class="hero-sub">
        Join us online — worship with us from anywhere in the world.
      </p>
    </div>
  </section>

  <!-- Live Player -->
  <section class="player-section">
    <div class="container">

      <!-- Offline state: shown when no live stream is active -->
      <div class="offline-state" id="offline-state">
        <div class="offline-icon" aria-hidden="true">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
        </div>
        <h2 class="offline-heading">Not Live Right Now</h2>
        <p class="offline-sub">We stream Sunday services, Good Morning Jesus (Monday), Wednesday Prayer Meeting, and Friday Bible Study. Check back at service time or watch a recent message below.</p>
        <div class="service-next">
          <div class="next-item"><strong>Sunday Service</strong><span>9:00 AM Jamaica Time</span></div>
          <div class="next-item"><strong>Good Morning Jesus</strong><span>Every Monday · Early Morning</span></div>
          <div class="next-item"><strong>Prayer Meeting</strong><span>Wednesday · 6:00 PM Jamaica Time</span></div>
          <div class="next-item"><strong>Friday Bible Study</strong><span>Every Friday · Online</span></div>
        </div>
        <a href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer" class="btn btn-gold">
          View Past Streams ↗
        </a>
      </div>

      <!-- Player: always loaded (opacity hidden) so IFrame API can initialise -->
      <!-- mute=1 enables browser autoplay for live detection; user can unmute via player controls -->
      <div class="player-wrap" id="player-wrap">
        <iframe
          id="live-iframe"
          class="player-iframe"
          src={YOUTUBE_LIVE}
          title="Jesus House Jamaica — Live Stream"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <div class="player-meta">
        <div class="service-times">
          <h3 class="times-heading">Join Us Live</h3>
          <ul class="times-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
              <strong>Sunday Service</strong> — 9:00 AM Jamaica Time
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
              <strong>Good Morning Jesus</strong> — Every Monday · Early Morning
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
              <strong>Wednesday Prayer Meeting</strong> — 6:00 PM Jamaica Time
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
              <strong>Friday Bible Study</strong> — Every Friday · Online
            </li>
          </ul>
        </div>

        <div class="channel-cta">
          <a
            href={YOUTUBE_CHANNEL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-youtube"
            aria-label="Subscribe on YouTube (opens in new tab)"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21.582 7.2s-.208-1.457-.847-2.099c-.81-.844-1.717-.848-2.133-.898C15.736 4 12 4 12 4s-3.736 0-6.602.203c-.416.05-1.323.054-2.133.898C2.626 5.743 2.418 7.2 2.418 7.2S2.208 8.893 2.208 10.587v1.633c0 1.693.21 3.387.21 3.387s.208 1.457.847 2.1c.81.844 1.876.817 2.351.905 1.706.162 7.254.212 7.384.213s5.68-.047 7.387-.209c.416-.05 1.323-.054 2.133-.898.639-.641.847-2.1.847-2.1s.21-1.694.21-3.387v-1.633C21.792 8.893 21.582 7.2 21.582 7.2zM9.854 14.264V9.527l5.753 2.378-5.753 2.359z" />
            </svg>
            Subscribe on YouTube
          </a>
          <p class="channel-note">Never miss a service — get notified when we go live</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Online Meetings (Zoom) -->
  <section class="zoom-section">
    <div class="container">
      <p class="section-label">JOIN ONLINE</p>
      <h2 class="section-heading">Virtual Gatherings</h2>
      <p class="section-sub">Connect via Zoom for midweek services and prayer meetings. Click any button to open directly in the Zoom app.</p>

      <div class="zoom-grid">
        {onlineMeetings.map(m => (
          <div class="zoom-card">
            <div class="zoom-icon" aria-hidden="true" set:html={m.icon}></div>
            <div class="zoom-info">
              <h3 class="zoom-name">{m.name}</h3>
              <p class="zoom-day">{m.day}</p>
              <p class="zoom-time">{m.time}</p>
              <p class="zoom-id">Meeting: {m.zoomDisplay}</p>
            </div>
            <a
              href={m.zoom}
              class="btn btn-zoom"
              title={`Join ${m.name} on Zoom`}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 10.5L22 7v10l-4.5-3.5V17a2 2 0 01-2 2H4a2 2 0 01-2-2V7a2 2 0 012-2h11.5a2 2 0 012 2v3.5z" /></svg>
              Join on Zoom
            </a>
          </div>
        ))}
      </div>

      <p class="zoom-fallback">
        Don't have the Zoom app?
        <a href="https://zoom.us/download" target="_blank" rel="noopener noreferrer">Download it free here</a>.
      </p>
    </div>
  </section>

  <!-- Recent Sermons -->
  <section class="sermons-section">
    <div class="container">
      <p class="section-label">ON DEMAND</p>
      <h2 class="section-heading">Recent Messages</h2>

      <div class="sermons-grid">
        {recentSermons.map(s => (
          <a
            href={`https://www.youtube.com/watch?v=${s.id}`}
            class="sermon-card"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Watch: ${s.title}`}
          >
            <div class="sermon-thumb">
              <img
                src={s.thumbnail}
                alt={s.title}
                loading="lazy"
                width="320"
                height="180"
              />
              <div class="thumb-play" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21" /></svg>
              </div>
            </div>
            <div class="sermon-info">
              <span class="sermon-category">{s.category}</span>
              <time class="sermon-date">{s.date}</time>
              <h3 class="sermon-title">{s.title}</h3>
            </div>
          </a>
        ))}
      </div>

      <div class="sermons-cta">
        <a
          href={YOUTUBE_CHANNEL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-gold"
          aria-label="View full sermon library on YouTube (opens in new tab)"
        >
          View Full Sermon Library
        </a>
        <a href="/sermons" class="btn btn-outline-navy">Browse Archive</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<!-- Live stream detector: polls /api/check-live (Netlify function) every 30s -->
<script>
// Minimal types for the YouTube IFrame API
interface YTPlayer {
  getDuration(): number
  seekTo(seconds: number, allowSeekAhead: boolean): void
  playVideo(): void
}
interface YTPlayerEvent { target: YTPlayer }
declare global {
  interface Window {
    YT?: { Player: new (id: string, opts: object) => YTPlayer }
    onYouTubeIframeAPIReady?: () => void
  }
}

(function () {
  const playerWrap = document.getElementById('player-wrap') as HTMLElement | null
  const offlineState = document.getElementById('offline-state') as HTMLElement | null
  const liveBadge = document.getElementById('live-badge') as HTMLElement | null
  const offlineBadge = document.getElementById('offline-badge') as HTMLElement | null
  const iframe = document.getElementById('live-iframe') as HTMLIFrameElement | null

  if (!playerWrap || !offlineState || !iframe)
    return

  let liveConfirmed = false

  // Queue of callbacks waiting for window.YT to be ready
  const ytReadyCallbacks: Array<() => void> = []
  let ytLoaded = false

  function onYTReady(cb: () => void) {
    if (ytLoaded && window.YT?.Player) {
      cb()
      return
    }
    ytReadyCallbacks.push(cb)
    if (!document.querySelector('script[src*="iframe_api"]')) {
      const s = document.createElement('script')
      s.src = 'https://www.youtube.com/iframe_api'
      document.head.appendChild(s)
    }
  }

  // Called by YouTube once the IFrame API script finishes loading
  window.onYouTubeIframeAPIReady = () => {
    ytLoaded = true
    ytReadyCallbacks.splice(0).forEach(cb => cb())
  }

  function seekToLiveEdge() {
    // YT.Player wraps the existing iframe (enablejsapi=1 already in src).
    // onReady fires once the player has buffered enough to report its duration.
    onYTReady(() => {
      new window.YT!.Player('live-iframe', {
        events: {
          onReady(e: YTPlayerEvent) {
            const duration = e.target.getDuration()
            // duration > 0 means the player has a DVR window; seek to its end = live edge
            if (duration > 0)
              e.target.seekTo(duration, true)
            e.target.playVideo()
          },
        },
      })
    })
  }

  function showLive(videoId?: string | null) {
    if (liveConfirmed)
      return
    liveConfirmed = true

    // Set the iframe src to the specific video ID so YT API can control it.
    // The live_stream channel URL is the fallback when no video ID is available.
    const base = videoId
      ? `https://www.youtube.com/embed/${videoId}`
      : `https://www.youtube.com/embed/live_stream?channel=UCO1S3nxtFg0_HXEMuZji5zg`
    iframe.src = `${base}?autoplay=1&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`

    playerWrap.classList.add('is-live')
    offlineState.style.display = 'none'
    if (liveBadge)
      liveBadge.style.display = 'inline-flex'
    if (offlineBadge)
      offlineBadge.style.display = 'none'

    // Seek to the live edge once the player reports its DVR duration
    if (videoId)
      seekToLiveEdge()
  }

  async function checkLive() {
    try {
      const res = await fetch('/api/check-live')
      const { isLive, videoId } = await res.json() as { isLive: boolean, videoId: string | null }
      if (isLive)
        showLive(videoId)
    }
    catch { /* network error — try again next interval */ }
  }

  // Check immediately on load, then every 30 seconds until live is confirmed
  checkLive()
  const timer = setInterval(() => {
    if (liveConfirmed) {
      clearInterval(timer)
      return
    }
    checkLive()
  }, 30_000)
})()
</script>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .page-hero {
    position: relative;
    background: var(--color-navy);
    padding: 7rem var(--container-px) 5rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 300px;
    background: radial-gradient(ellipse, rgba(212, 168, 67, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner { position: relative; z-index: 1; }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 900;
    color: var(--color-white);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.65);
    max-width: 520px;
    margin: 0 auto;
  }

  /* Live pulse badge */
  .live-pulse {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #E53E3E;
    border-radius: 50%;
    margin-right: 6px;
    vertical-align: middle;
    animation: blink-dot 1.4s ease-in-out infinite;
  }

  @keyframes blink-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.7); }
  }

  /* ── Player ───────────────────────────────────────── */
  .player-section {
    background: var(--color-cream);
    padding: var(--section-padding) var(--container-px);
  }

  /* ── Offline state ─────────────────────────────────── */
  .offline-state {
    text-align: center;
    padding: 3rem 1rem;
    max-width: 560px;
    margin: 0 auto 2.5rem;
  }

  .offline-icon {
    color: var(--color-gold);
    margin-bottom: 1.5rem;
    opacity: 0.7;
  }

  .offline-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .offline-sub {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .service-next {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .next-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    background: var(--color-white);
    border-radius: 0.5rem;
    border: 1px solid rgba(13, 27, 62, 0.08);
    font-size: 0.9rem;
    color: var(--color-navy);
  }

  .next-item span {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .player-wrap {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    background: #0a0a0a;
    box-shadow: 0 24px 64px rgba(13, 27, 62, 0.22);
    /* Collapsed in offline mode — iframe still loads and fires IFrame API events */
    opacity: 0;
    pointer-events: none;
    max-height: 0;
    padding-bottom: 0;
    margin-bottom: 0;
    transition: opacity 0.4s ease, max-height 0.4s ease, padding-bottom 0.4s ease, margin-bottom 0.4s ease;
  }

  .player-wrap.is-live {
    opacity: 1;
    pointer-events: auto;
    max-height: 800px;
    padding-bottom: 56.25%;
    margin-bottom: 2.5rem;
    height: 0;
  }

  .player-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .player-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .player-meta { grid-template-columns: 1fr 1fr; }
  }

  .times-heading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .times-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .times-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .times-list svg { color: var(--color-gold); flex-shrink: 0; margin-top: 2px; }

  .channel-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .channel-cta { align-items: flex-end; text-align: right; }
  }

  .btn-youtube {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.75rem;
    background-color: #FF0000;
    color: white;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 0.5rem;
    text-decoration: none;
    border: none;
    transition: background-color 0.18s var(--ease-out), transform 0.15s var(--ease-out), box-shadow 0.18s var(--ease-out);
  }

  .btn-youtube:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-youtube:hover {
      background-color: #CC0000;
      color: white;
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(255, 0, 0, 0.3);
    }
  }

  .channel-note {
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  /* ── Zoom Section ─────────────────────────────────── */
  .zoom-section {
    background: var(--color-white);
    padding: var(--section-padding) var(--container-px);
    text-align: center;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .section-sub {
    font-size: 1rem;
    color: var(--color-muted);
    max-width: 560px;
    margin: 0 auto 3rem;
    line-height: 1.7;
  }

  .zoom-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (min-width: 640px) { .zoom-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .zoom-grid { grid-template-columns: repeat(3, 1fr); } }

  .zoom-card {
    border: 1.5px solid rgba(13, 27, 62, 0.1);
    border-radius: 1rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .zoom-card:hover {
    border-color: var(--color-gold);
    box-shadow: 0 8px 32px rgba(212, 168, 67, 0.12);
  }

  .zoom-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(212, 168, 67, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .zoom-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .zoom-day {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .zoom-time { font-size: 0.88rem; color: var(--color-text); }

  .zoom-id {
    font-size: 0.78rem;
    color: var(--color-muted);
    font-family: 'Courier New', monospace;
    background: rgba(13, 27, 62, 0.04);
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
  }

  .btn-zoom {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
