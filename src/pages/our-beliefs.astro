---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';

const beliefs = [
  {
    article: '01',
    title: 'The Holy Scriptures',
    summary: 'The Bible is God\'s Word',
    text: 'We believe the Bible — both Old and New Testaments — to be the inspired, infallible, and inerrant Word of God. It is the supreme and final authority in all matters of faith and conduct. Every Scripture is God-breathed and profitable for doctrine, reproof, correction, and instruction in righteousness.',
    ref: '2 Timothy 3:16-17; 2 Peter 1:20-21',
  },
  {
    article: '02',
    title: 'The Holy Trinity',
    summary: 'One God in Three Persons',
    text: 'We believe in one God, eternally existing and revealed in three co-equal, co-eternal persons: God the Father, God the Son (Jesus Christ), and God the Holy Spirit. These three are one in nature, essence, and glory — distinct in person but undivided in being.',
    ref: 'Matthew 28:19; 2 Corinthians 13:14; John 1:1-3',
  },
  {
    article: '03',
    title: 'Jesus Christ',
    summary: 'Fully God, Fully Man',
    text: 'We believe in the full deity and full humanity of our Lord Jesus Christ. He was conceived by the Holy Spirit, born of the virgin Mary, lived a sinless life, and voluntarily offered Himself as the atoning sacrifice for the sins of all humanity. He rose bodily from the dead, ascended to the Father\'s right hand, and will return in glory.',
    ref: 'John 1:1,14; Isaiah 7:14; 1 Corinthians 15:3-4',
  },
  {
    article: '04',
    title: 'Salvation by Grace',
    summary: 'A Free Gift Through Faith',
    text: 'We believe that salvation is the gracious gift of God, received through repentance toward God and faith in the Lord Jesus Christ. It cannot be earned by human effort, religious works, or moral achievement. The moment a person truly believes, they are born again, justified, and adopted as a child of God.',
    ref: 'Ephesians 2:8-9; Romans 10:9-10; John 3:3',
  },
  {
    article: '05',
    title: 'The Holy Spirit',
    summary: 'The Indwelling Comforter',
    text: 'We believe in the present ministry of the Holy Spirit, who convicts the world of sin, regenerates the believing heart, indwells every believer, and baptises them with power for service. The Holy Spirit distributes spiritual gifts to the Church and produces His fruit in the lives of those who yield to Him.',
    ref: 'Acts 1:8; 1 Corinthians 12:4-11; Galatians 5:22-23',
  },
  {
    article: '06',
    title: 'The Church',
    summary: 'The Body of Christ',
    text: 'We believe in the universal Church — the body and bride of Christ — composed of all who have been regenerated by the Holy Spirit. The local church is the God-ordained expression of this body, called to gather in worship, equip believers through the Word, administer the sacraments, and extend the mission of Christ to the world.',
    ref: 'Ephesians 1:22-23; Matthew 16:18; Acts 2:42-47',
  },
  {
    article: '07',
    title: 'Water Baptism & The Lord\'s Supper',
    summary: 'Ordained Sacraments',
    text: 'We believe in water baptism by immersion as a public declaration of faith and identification with the death, burial, and resurrection of Christ. We also observe the Lord\'s Supper as a memorial of Christ\'s sacrifice, proclaiming His death until He comes again.',
    ref: 'Romans 6:3-4; Matthew 28:19; 1 Corinthians 11:23-26',
  },
  {
    article: '08',
    title: 'The Second Coming',
    summary: 'Christ Will Return',
    text: 'We believe in the personal, visible, and glorious return of the Lord Jesus Christ to establish His kingdom. At His return, the dead in Christ will be raised and living believers will be transformed. There will be a final judgment, and the righteous will enter eternal life with God.',
    ref: 'Acts 1:11; 1 Thessalonians 4:16-17; Revelation 21:1-4',
  },
];
---

<Layout
  title="Our Beliefs"
  description="Explore the core doctrinal beliefs of Jesus House Jamaica — our faith in Scripture, the Trinity, salvation, the Holy Spirit, and the return of Christ. RCCG parish in Kingston, Jamaica."
>
  <Nav heroDark={true} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="section-label">Theology</span>
      <h1 class="hero-title">Our Beliefs</h1>
      <p class="hero-sub">
        Grounded in the historic faith — what we believe shapes who we are,
        how we worship, and how we serve.
      </p>
    </div>
  </section>

  <!-- Intro -->
  <section class="intro-section">
    <div class="container intro-inner">
      <div class="intro-quote">
        <svg class="intro-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        <p class="intro-text">
          Jesus House Jamaica holds firmly to the historic, orthodox faith of the Christian Church,
          as expressed in Scripture and confessed by the global Redeemed Christian Church of God.
          These are not merely doctrines — they are convictions that shape every dimension of our life together.
        </p>
      </div>
    </div>
  </section>

  <!-- Beliefs Articles -->
  <section class="beliefs-section">
    <div class="container">
      <div class="beliefs-list">
        {beliefs.map((belief, idx) => (
          <article class="belief-article" id={`article-${belief.article}`}>
            <div class="belief-number-col">
              <span class="belief-number">{belief.article}</span>
              {idx < beliefs.length - 1 && <div class="belief-line" aria-hidden="true"></div>}
            </div>
            <div class="belief-content">
              <span class="belief-summary">{belief.summary}</span>
              <h2 class="belief-title">{belief.title}</h2>
              <p class="belief-text">{belief.text}</p>
              <div class="belief-ref">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
                {belief.ref}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- RCCG Confession link -->
  <section class="confession-cta">
    <div class="container confession-inner">
      <div class="confession-text">
        <span class="section-label">Go Deeper</span>
        <h2 class="confession-heading">Read Our Full Confession</h2>
        <p>
          Beyond these core beliefs, we hold to the full RCCG Apostolic Confession — a comprehensive
          statement of faith that has guided the Redeemed Christian Church of God since its founding.
        </p>
      </div>
      <div class="confession-links">
        <a href="/our-confession" class="btn btn-gold">Our Apostolic Confession</a>
        <a href="/our-mission" class="btn btn-outline-navy">Our Mission & Vision</a>
      </div>
    </div>
  </section>

  <!-- Questions CTA -->
  <section class="questions-cta">
    <div class="container questions-inner">
      <h2 class="questions-heading">Questions About Faith?</h2>
      <p class="questions-sub">
        We would love to explore the faith with you. Reach out to us — our pastors and leadership
        team are here to walk alongside you on your spiritual journey.
      </p>
      <a href="/contact" class="btn btn-gold">Contact Us</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    background-color: var(--color-navy);
    position: relative;
    overflow: hidden;
    padding: 9rem 0 6rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 70%, rgba(212, 168, 67, 0.1) 0%, transparent 60%),
      radial-gradient(ellipse at 85% 10%, rgba(224, 90, 43, 0.06) 0%, transparent 50%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 620px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.75;
    max-width: 50ch;
  }

  /* Intro */
  .intro-section {
    background-color: var(--color-cream);
    padding: 4rem 0;
  }

  .intro-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .intro-quote {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .intro-icon {
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .intro-text {
    font-family: var(--font-accent);
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-navy);
    line-height: 1.75;
    font-style: italic;
  }

  /* Beliefs */
  .beliefs-section {
    background-color: var(--color-white);
    padding: var(--section-padding) 0;
  }

  .beliefs-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .belief-article {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 2rem;
    padding-bottom: 3rem;
  }

  @media (max-width: 640px) {
    .belief-article {
      grid-template-columns: 56px 1fr;
      gap: 0 1.25rem;
    }
  }

  .belief-number-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.25rem;
  }

  .belief-number {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-gold);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(212, 168, 67, 0.1);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .belief-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(to bottom, rgba(212, 168, 67, 0.3), transparent);
    margin-top: 0.5rem;
    min-height: 40px;
  }

  .belief-content {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(13, 27, 62, 0.07);
  }

  .belief-article:last-child .belief-content {
    border-bottom: none;
  }

  .belief-summary {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-coral);
    margin-bottom: 0.5rem;
  }

  .belief-title {
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    color: var(--color-navy);
    margin-bottom: 0.875rem;
  }

  .belief-text {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: 1rem;
    max-width: 72ch;
  }

  .belief-ref {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-navy);
  }

  .belief-ref svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  /* Confession CTA */
  .confession-cta {
    background-color: var(--color-cream);
    padding: 5rem 0;
  }

  .confession-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: flex-start;
  }

  @media (min-width: 900px) {
    .confession-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .confession-text {
    max-width: 520px;
  }

  .confession-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-navy);
    margin-bottom: 0.875rem;
  }

  .confession-text p {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .confession-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    flex-shrink: 0;
  }

  /* Questions CTA */
  .questions-cta {
    background: linear-gradient(135deg, var(--color-navy) 0%, #172040 100%);
    padding: 5rem 0;
    text-align: center;
  }

  .questions-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .questions-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .questions-sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }
  /* ── Mobile overrides ─────────────────────────────── */
  @media (max-width: 640px) {
    [class$="-hero"] { padding-top: 5.5rem; padding-bottom: 3.5rem; }
    [class*="-card"] { padding: 1.5rem 1.25rem; }
  }
</style>
